#!/usr/bin/env bash
# neofetch-lite — tiny neofetch-style system info banner (pure bash, no deps).
#   neofetch-lite --min       one-line summary
#   neofetch-lite --logo      logo only
#   neofetch-lite --no-logo   summary only (no logo block)
set -euo pipefail

logo=(
'     _   _ ______  _____  _____ ____  '
'    | \ | | ____|/ _ \ \/ /_ _|  _ \ '
'    |  \| |  _| | | | \  /  | | | |_) |'
'    | |\  | |___| |_| /  \  | | |  __/'
'    |_| \_|_____/\___/_/\_\___|_|    '
'      a NeoApps demo        '
)

os_pretty() {
  grep -m1 '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || echo "NeoOS"
}

kernel()   { uname -r 2>/dev/null || echo "n/a"; }
uptime_s() {
  awk '{s=$1; d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60);
        printf "%dd %dh %dm", d, h, m}' /proc/uptime 2>/dev/null || echo "n/a"
}
packages() { echo "$(dpkg-query -W -f='${Package}\n' 2>/dev/null | wc -l) (dpkg)"; }
shell()    { printf '%s' "${SHELL:-$0}"; }
memory() {
  awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.1f / %.1f GiB", a/1024/1024, t/1024/1024}' \
    /proc/meminfo 2>/dev/null || echo "n/a"
}
cpu()    { grep -m1 'model name' /proc/cpuinfo 2>/dev/null | sed 's/.*: *//' | cut -c1-40 || echo "n/a"; }
disk()   { df -h / 2>/dev/null | awk 'NR==2{printf "%s free / %s", $4, $2}' || echo "n/a"; }

rows=(
  "OS:        $(os_pretty)"
  "Host:      ${USER:-root}@$(hostname -s 2>/dev/null || echo neoos)"
  "Kernel:    $(kernel)"
  "Uptime:    $(uptime_s)"
  "Packages:  $(packages)"
  "Shell:     $(basename "$(shell)" 2>/dev/null || echo "$0")"
  "Memory:    $(memory)"
  "Disk:      $(disk)"
  "CPU:       $(cpu)"
)

show_logo() {
  local w=0 i
  for ((i=0; i<${#logo[@]}; i++)); do (( ${#logo[i]} > w )) && w=${#logo[i]}; done
  for ((i=0; i<${#rows[@]}; i++)); do
    if (( i < ${#logo[@]} )); then
      printf '\033[1;32m%s\033[0m  \033[36m%s\033[0m\n' "${logo[i]}" "${rows[i]}"
    else
      printf '%*s  \033[2m%s\033[2m\n' "$w" "" "${rows[i]}"
    fi
  done
}

case "${1:-full}" in
  --min|-m)  printf '%s | %s | kernel %s | %s | %s\n' \
               "$(os_pretty)" "$(packages)" "$(kernel)" "$(memory)" "$(disk)" ;;
  --logo)    for l in "${logo[@]}"; do printf '\033[1;32m%s\033[0m\n' "$l"; done ;;
  --no-logo) for r in "${rows[@]}"; do printf '  %s\n' "$r"; done ;;
  *)         show_logo ;;
esac
