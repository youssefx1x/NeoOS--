# ---------------------------------------------------------------------
# NeoOS driver manifest — source of truth read by `neos-uranium`.
# One package per line; lines beginning with '#' are comments.
# These packages are installed at runtime (network) by neos-uranium.
# ---------------------------------------------------------------------

# --- GPU / Mesa / Vulkan ---
mesa-utils
libgl1-mesa-dri
mesa-vulkan-drivers
vulkan-tools
mesa-va-drivers
mesa-vdpau-drivers
intel-media-va-driver

# --- AMD / Radeon firmware ---
firmware-amd-graphics

# --- NVIDIA (proprietary) ---
# NOTE: requires the 'non-free' apt component (enabled by neos-mirror /
# sources.list). The metapackage 'nvidia-driver' pulls in the matching driver.
nvidia-driver
nvidia-settings
firmware-nvidia-graphics

# --- Generic Linux firmware ---
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree

# --- WiFi / wireless firmware ---
firmware-realtek
firmware-atheros
firmware-iwlwifi
firmware-brcm80211

# --- Networking tools ---
iw
rfkill
wpasupplicant
iwd
network-manager
network-manager-iwd

# --- Bluetooth ---
bluez
bluez-tools

# --- Audio ---
alsa-utils
pipewire
pipewire-pulse
pipewire-alsa

# --- Printing ---
cups
printer-driver-gutenprint

# --- Hardware inventory + QEMU guest agent (virtio/time sync) ---
hwdata
pciutils
usbutils
lshw
qemu-guest-agent
