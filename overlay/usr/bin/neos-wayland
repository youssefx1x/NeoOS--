#!/usr/bin/env bash
# neos-wayland — start a Wayland session (Weston compositor with XWayland)
# in a terminal-driven environment. Installs the stack on first run.

set -euo pipefail

log() { printf '\033[1;36m[neos-wayland]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[neos-wayland]\033[0m %s\n' "$*" >&2; }

run_root() {
  if [[ $EUID -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    err "root required: $*"
    return 1
  fi
}

ensure_stack() {
  local missing=()
  for p in weston seatd xwayland foot wmenu; do
    command -v "$p" >/dev/null 2>&1 || missing+=("$p")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    log "Installing missing Wayland components: ${missing[*]}"
    local pkgs=(weston seatd xwayland foot wmenu mesa-utils libgl1-mesa-dri)
    if ! command -v apt-get >/dev/null 2>&1; then
      err "apt-get not found. Install manually:"
      err "  sudo apt install weston seatd xwayland foot wmenu mesa-utils"
      return 1
    fi
    if run_root apt-get install -y "${pkgs[@]}" 2>&1; then
      log "Wayland stack installed."
    else
      err "apt-get install failed."
      err "Try: sudo apt install ${pkgs[*]}"
      return 1
    fi
  fi
}

run_session() {
  local session_script="${XDG_CONFIG_HOME:-$HOME/.config}/neos/wayland-session.sh"
  mkdir -p "$(dirname "$session_script")"
  if [[ ! -f "$session_script" ]]; then
    cat > "$session_script" <<'EOF'
#!/usr/bin/env bash
# NeoOS Wayland session: start foot terminal inside Weston.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME/.xdg}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_SESSION_TYPE=wayland
weston --backend=auto --xwayland &
sleep 2
export DISPLAY=:0
foot
EOF
    chmod +x "$session_script"
  fi
  bash "$session_script"
}

case "${1:-}" in
  install) ensure_stack;;
  session) run_session;;
  *) ensure_stack && run_session;;
esac
