#!/usr/bin/env bash
# neos-inode — filesystem inode / disk usage
set -euo pipefail
NEOS_VERSION="${NEOS_VERSION:-1.2.0}"
case "${1:-}" in
  -h|--help) echo "usage: neos-inode [FILESYSTEM...]  (inode + disk usage via df -i)" ; exit 0 ;;
  --version|-v) echo "neos-inode ${NEOS_VERSION}" ; exit 0 ;;
esac
if [[ $# -eq 0 ]]; then
  df -hT -i
else
  df -hT -i "$@"
fi
