#!/usr/bin/env bash
# neos-apps — NeoApps native application framework (list/run/install/search).
#
# Each app lives in $APPDIR/<name>/ with an optional manifest file
# (app.manifest) defining metadata: NAME, VERSION, DESCRIPTION,
# AUTHOR, ENTRY (binary name under bin/), DEPENDS (space-separated).
# Binaries are expected at <dir>/bin/<entry>.
#
#   neos-apps                       list installed apps with versions
#   neos-apps list                  alias for list
#   neos-apps info <app>            show full metadata for an app
#   neos-apps run <app> [args...]   run an app by name
#   neos-apps search <keyword>      search apps by name/description
#   neos-apps install <name> [src]   install app from NEOS_APPS_INDEX or local dir
#   neos-apps uninstall <app>       remove an installed app
#   neos-apps update                refresh the remote app index
#   neos-apps status                show running-state of installed apps
#   neos-apps help                  show this usage

set -euo pipefail

APPDIR="${NEOS_APPS_DIR:-/opt/neos-apps}"
NEOS_APPS_INDEX="${NEOS_APPS_INDEX:-https://github.com/youssefx1x/NeoOS--/raw/main/config/neos-apps-index.tsv}"
NEOS_APPS_INDEX_LOCAL="${NEOS_APPS_INDEX_LOCAL:-/var/lib/neos/apps-index.tsv}"

log()  { printf '\033[1;36m[neos-apps]\033[0m %s\n' "$*"; }
info(){ printf '\033[1;32m[neos-apps]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[neos-apps]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[neos-apps]\033[0m %s\n' "$*" >&2; }

has_app()    { [[ -d "$APPDIR/$1" ]]; }
app_manifest() { local m="$APPDIR/$1/app.manifest"; [[ -f "$m" ]] && echo "$m" || true; }

# Print a single field from a manifest (key=value lines).
manifest_get() {
  local manifest="$1" key="$2" val
  val=$(grep -m1 "^${key}=" "$manifest" 2>/dev/null | cut -d= -f2-) || true
  # Strip surrounding quotes if present
  val="${val#\"}"; val="${val%\"}"
  val="${val#\'}"; val="${val%\'}"
  printf '%s' "$val"
}

# Resolve the entry binary for an app.
app_entry() {
  local app="$1" entry=""
  if [[ -f "$APPDIR/$app/app.manifest" ]]; then
    entry=$(manifest_get "$APPDIR/$app/app.manifest" "ENTRY")
  fi
  if [[ -z "$entry" ]]; then
    entry="$app"
  fi
  printf '%s' "$entry"
}

# Check that all declared dependencies exist on the system.
check_deps() {
  local manifest="$1"
  local deps dep
  deps=$(manifest_get "$manifest" "DEPENDS")
  [[ -z "$deps" ]] && return 0
  for dep in $deps; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      return 1
    fi
  done
  return 0
}

# Colorize a status dot.
status_dot() {
  local running="$1"
  if [[ "$running" == "yes" ]]; then
    printf '\033[1;32m*\033[0m'
  else
    printf '\033[1;31m*\033[0m'
  fi
}

# --- subcommands -------------------------------------------------------------

do_list() {
  if [[ ! -d "$APPDIR" ]] || [[ -z "$(ls -A "$APPDIR" 2>/dev/null)" ]]; then
    echo "(no apps installed in $APPDIR)"
    return 0
  fi
  local name ver desc
  for dir in "$APPDIR"/*/; do
    [[ -d "$dir" ]] || continue
    name=$(basename "$dir")
    if [[ -f "$dir/app.manifest" ]]; then
      ver=$(manifest_get "$dir/app.manifest" "VERSION" 2>/dev/null || echo "—")
      desc=$(manifest_get "$dir/app.manifest" "DESCRIPTION" 2>/dev/null || echo "")
    else
      ver="—"
      desc=""
    fi
    printf '  %-18s %-10s %s\n' "$name" "${ver:-—}" "${desc:-no description}"
  done
}

do_info() {
  local app="${1:-}"
  if [[ -z "$app" ]]; then
    err "usage: neos-apps info <app>"
    exit 2
  fi
  if ! has_app "$app"; then
    err "app '$app' not found in $APPDIR"
    exit 1
  fi
  local manifest="$APPDIR/$app/app.manifest"
  echo "app:        $app"
  echo "location:   $APPDIR/$app"
  if [[ -f "$manifest" ]]; then
    echo "version:    $(manifest_get "$manifest" VERSION)"
    echo "description:$(manifest_get "$manifest" DESCRIPTION)"
    echo "author:     $(manifest_get "$manifest" AUTHOR)"
    echo "entry:      $(manifest_get "$manifest" ENTRY)"
    echo "depends:    $(manifest_get "$manifest" DEPENDS)"
  else
    echo "(no manifest — bare app directory)"
  fi
  echo "binaries:"
  if [[ -d "$APPDIR/$app/bin" ]]; then
    local f
    for f in "$APPDIR/$app/bin/"*; do
      [[ -f "$f" ]] || continue
      printf '  %s\n' "$(basename "$f")"
    done
  else
    echo "  (no bin/ directory)"
  fi
}

do_run() {
  local app="${1:-}"
  if [[ -z "$app" ]]; then
    err "usage: neos-apps run <app> [args...]"
    exit 2
  fi
  if ! has_app "$app"; then
    err "app '$app' not found in $APPDIR"
    exit 1
  fi
  local entry
  entry=$(app_entry "$app")
  local exe="$APPDIR/$app/bin/$entry"
  if [[ ! -x "$exe" ]]; then
    err "entry point '$entry' not found or not executable"
    err "checked: $exe"
    exit 1
  fi
  local manifest
  manifest=$(app_manifest "$app")
  if [[ -n "$manifest" ]] && ! check_deps "$manifest"; then
    warn "missing dependencies (continuing anyway)"
  fi
  exec "$exe" "${@:2}"
}

do_search() {
  local keyword="${1:-}"
  if [[ -z "$keyword" ]]; then
    err "usage: neos-apps search <keyword>"
    exit 2
  fi
  local found=0 name ver desc
  for dir in "$APPDIR"/*/; do
    [[ -d "$dir" ]] || continue
    name=$(basename "$dir")
    if [[ -f "$dir/app.manifest" ]]; then
      ver=$(manifest_get "$dir/app.manifest" "VERSION" 2>/dev/null || echo "—")
      desc=$(manifest_get "$dir/app.manifest" "DESCRIPTION" 2>/dev/null || echo "")
    else
      ver="—"
      desc=""
    fi
    local lc_name lc_desc lc_kw
    lc_name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
    lc_desc=$(printf '%s' "$desc" | tr '[:upper:]' '[:lower:]')
    lc_kw=$(printf '%s' "$keyword" | tr '[:upper:]' '[:lower:]')
    if [[ "$lc_name" == *"$lc_kw"* ]] || [[ "$lc_desc" == *"$lc_kw"* ]]; then
      printf '  %-18s %-10s %s\n' "$name" "${ver:-—}" "${desc:-no description}"
      found=$((found + 1))
    fi
  done
  if [[ "$found" -eq 0 ]]; then
    echo "(no apps matching '$keyword' — try 'neos-apps update' to refresh the index)"
  fi
}

do_install() {
  local app="${1:-}"
  if [[ -z "$app" ]]; then
    err "usage: neos-apps install <app-name> [local-dir|url]"
    exit 2
  fi
  local src="${2:-}"
  local target="$APPDIR/$app"
  if has_app "$app"; then
    warn "app '$app' already installed at $target"
    read -r -p "overwrite? [y/N] " yn
    [[ "$yn" =~ ^[Yy]$ ]] || { echo "aborted."; return 0; }
  fi
  local tmpdir
  tmpdir=$(mktemp -d)
  if [[ -z "$src" ]]; then
    if [[ ! -f "$NEOS_APPS_INDEX_LOCAL" ]]; then
      err "no app index found at $NEOS_APPS_INDEX_LOCAL"
      err "run 'neos-apps update' first, or provide a source: neos-apps install <name> <dir|url>"
      rm -rf "$tmpdir"
      exit 1
    fi
    local url
    url=$(awk -v k="$app" -F'\t' '$1==k {print $2}' "$NEOS_APPS_INDEX_LOCAL" 2>/dev/null | head -1)
    if [[ -z "$url" ]]; then
      err "app '$app' not found in index"
      info "run 'neos-apps update' to refresh, or install from a local dir:"
      info "  neos-apps install $app /path/to/app"
      rm -rf "$tmpdir"
      exit 1
    fi
    src="$url"
  fi
  if [[ "$src" == http://* || "$src" == https://* ]]; then
    if command -v curl >/dev/null 2>&1; then
      info "downloading $app from $src ..."
      curl -fsSL "$src" -o "$tmpdir/app.tar.gz" || { err "download failed"; rm -rf "$tmpdir"; exit 1; }
    elif command -v wget >/dev/null 2>&1; then
      info "downloading $app from $src ..."
      wget -qO "$tmpdir/app.tar.gz" "$src" || { err "download failed"; rm -rf "$tmpdir"; exit 1; }
    else
      err "need curl or wget to download from URL"
      rm -rf "$tmpdir"
      exit 1
    fi
    if ! tar xzf "$tmpdir/app.tar.gz" -C "$tmpdir" 2>/dev/null; then
      err "failed to extract archive"
      rm -rf "$tmpdir"
      exit 1
    fi
    src="$tmpdir"
  elif [[ -d "$src" ]]; then
    : # local directory — nothing to extract
  else
    err "source '$src' is not a directory or URL"
    rm -rf "$tmpdir"
    exit 1
  fi
  mkdir -p "$target"
  cp -r "$src/." "$target/" 2>/dev/null || { err "failed to copy app files"; rm -rf "$tmpdir"; exit 1; }
  chmod +x "$target/bin/"* 2>/dev/null || true
  info "installed '$app' to $target"
  rm -rf "$tmpdir"
}

do_uninstall() {
  local app="${1:-}"
  if [[ -z "$app" ]]; then
    err "usage: neos-apps uninstall <app>"
    exit 2
  fi
  if ! has_app "$app"; then
    warn "app '$app' is not installed"
    return 0
  fi
  read -r -p "Remove '$app' from $APPDIR? [y/N] " yn
  [[ "$yn" =~ ^[Yy]$ ]] || { echo "aborted."; return 0; }
  rm -rf "$APPDIR/$app"
  info "uninstalled '$app'"
}

do_update() {
  if [[ -z "$NEOS_APPS_INDEX" ]]; then
    warn "NEOS_APPS_INDEX is not set; cannot update index"
    return 0
  fi
  info "updating app index from $NEOS_APPS_INDEX ..."
  local tmpf
  tmpf=$(mktemp)
  if command -v curl >/dev/null 2>&1; then
    if curl -fsSL "$NEOS_APPS_INDEX" -o "$tmpf"; then
      mkdir -p "$(dirname "$NEOS_APPS_INDEX_LOCAL")" 2>/dev/null || true
      mv "$tmpf" "$NEOS_APPS_INDEX_LOCAL"
      info "index saved to $NEOS_APPS_INDEX_LOCAL"
    else
      err "failed to download index"
      rm -f "$tmpf"
      return 1
    fi
  elif command -v wget >/dev/null 2>&1; then
    if wget -qO "$tmpf" "$NEOS_APPS_INDEX"; then
      mkdir -p "$(dirname "$NEOS_APPS_INDEX_LOCAL")" 2>/dev/null || true
      mv "$tmpf" "$NEOS_APPS_INDEX_LOCAL"
      info "index saved to $NEOS_APPS_INDEX_LOCAL"
    else
      err "failed to download index"
      rm -f "$tmpf"
      return 1
    fi
  else
    err "need curl or wget to update index"
    rm -f "$tmpf"
    return 1
  fi
}

do_status() {
  if [[ ! -d "$APPDIR" ]] || [[ -z "$(ls -A "$APPDIR" 2>/dev/null)" ]]; then
    echo "(no apps installed in $APPDIR)"
    return 0
  fi
  local name entry exe running
  for dir in "$APPDIR"/*/; do
    [[ -d "$dir" ]] || continue
    name=$(basename "$dir")
    entry=$(app_entry "$name")
    exe="$APPDIR/$name/bin/$entry"
    if [[ -x "$exe" ]]; then
      if pgrep -f "$exe" >/dev/null 2>&1; then
        running="yes"
      else
        running="no"
      fi
    else
      running="no-entry"
    fi
    printf '  '
    status_dot "$running"
    printf '  %-18s  %s\n' "$name" "$running"
  done
}

do_help() {
  sed -n '2,19p' "$0" | sed 's/^#   /  /; s/^#//'
}

# --- main dispatch -----------------------------------------------------------

case "${1:-}" in
  ""|list|ls)   do_list ;;
  info)        shift; do_info "$@" ;;
  run)         shift; do_run "$@" ;;
  search)      shift; do_search "${1:-}" ;;
  install)     shift; do_install "$@" ;;
  uninstall|remove) shift; do_uninstall "${1:-}" ;;
  update)      do_update ;;
  status)      do_status ;;
  help|-h|--help) do_help ;;
  *) err "unknown option '$1'"; err "run 'neos-apps help' for usage"; exit 2 ;;
esac
