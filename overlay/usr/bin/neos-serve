#!/usr/bin/env bash
# neos-serve — quick file sharing / HTTP server over the LAN.
# Wraps python3 http.server with a sensible default port, directory
# listing and a URL to share. Supports upload mode for easy transfers.
#
#   neos-serve [dir]           serve a directory on port 8000
#   neos-serve -p 8080 [dir]   serve on port 8080
#   neos-serve --upload [dir]  serve with file upload enabled
#   neos-serve --port          just print a usable free port
#   neos-serve --range <n>     print n free ports

set -euo pipefail

log() { printf '\033[1;36m[neos-serve]\033[0m %s\n' "$*"; }

dir="."
port=8000
upload=0

usage() { sed -n '2,9p' "$0" | sed 's/^#   /  /; s/^#//'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--port) port="$2"; shift 2 ;;
    --upload)  upload=1; shift ;;
    --port)    python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()'; exit 0 ;;
    --range)   python3 -c 'import socket,sys
n=int(sys.argv[1])
for i in range(n):
    s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()' "$2"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) dir="$1"; shift ;;
  esac
done

[[ -d "$dir" ]] || { echo "no such directory: $dir" >&2; exit 1; }

if ! command -v python3 >/dev/null 2>&1; then
  echo "neos-serve needs python3: pkg install python3" >&2
  exit 1
fi

lan_ip() {
  hostname -I 2>/dev/null | awk '{print $1}' || ip -4 addr show 2>/dev/null \
    | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '^127\.' | head -1 \
    || echo "127.0.0.1"
}

log "Sharing  : $dir"
log "URL      : http://$(lan_ip):$port  (local: http://127.0.0.1:$port)"
[[ "$upload" -eq 1 ]] && log "Upload   : curl -F file=@x.tar.gz http://$(lan_ip):$port/"

if [[ "$upload" -eq 1 ]]; then
  python3 - "$port" "$dir" <<'PYEOF'
import cgi, os, sys, socket
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
SERVE_DIR = os.path.abspath(sys.argv[2]) if len(sys.argv) > 2 else os.getcwd()
class H(SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw):
        super().__init__(*a, directory=SERVE_DIR, **kw)
    def do_POST(self):
        ctype, pdict = cgi.parse_header(self.headers.get('Content-Type', ''))
        if ctype == 'multipart/form-data':
            form = cgi.FieldStorage(fp=self.rfile, headers=self.headers,
                                    environ={'REQUEST_METHOD': 'POST',
                                             'CONTENT_TYPE': self.headers['Content-Type']})
            for f in form.list:
                if f.filename:
                    name = os.path.basename(f.filename)
                    with open(os.path.join(SERVE_DIR, name), 'wb') as out:
                        out.write(f.file.read())
                    self.send_response(200); self.end_headers()
                    self.wfile.write(('uploaded ' + name).encode())
                    return
        self.send_response(400); self.end_headers()
    def log_message(self, *a): pass
ThreadingHTTPServer(('0.0.0.0', int(sys.argv[1])), H).serve_forever()
PYEOF
else
  cd "$dir"
  exec python3 -m http.server "$port" --bind 0.0.0.0
fi
