#!/usr/bin/env bash
# neos-fetch — NeoOS system information banner.
# A fast, dependency-light neofetch-style tool with an ASCII logo.
#   neos-fetch              show full banner
#   neos-fetch --min        minimal one-line summary
#   neos-fetch --logo       ASCII logo only

set -euo pipefail

logo=(
'     _   _ ______  _____  ____  '
'    | \ | | ____|/ _ \ \/ /\ \/ /'
'    |  \| |  _| | | | \  /  \  / '
'    | |\  | |___| |_| /  \  /  \ '
'    |_| \_|_____|\___/_/\_\/_/\_\'
'      terminal-first Debian 13   '
'      NeoOS 2.0                  '
)

os_pretty() {
  grep -h '^PRETTY_NAME=' /etc/os-release 2>/dev/null | head -1 | cut -d= -f2 | tr -d '"' \
    || echo "NeoOS"
}

kernel()  { uname -r; }
uptime_s() {
  awk '{s=$1; d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60);
        printf "%dd %dh %dm", d, h, m}' /proc/uptime 2>/dev/null || echo "?"
}
packages() {
  local n
  n=$(dpkg-query -W -f='${Package}\n' 2>/dev/null | wc -l)
  echo "$n (dpkg)"
}
shell()   { basename "$(basename "${SHELL:-$0}")"; }
memory()  {
  awk '/MemTotal/{t=$2/1024/1024} /MemAvailable/{a=$2/1024/1024}
       END{printf "%.1fGiB / %.1fGiB", a, t}' /proc/meminfo 2>/dev/null
}
cpu()     { grep -m1 'model name' /proc/cpuinfo | sed 's/.*: *//' | cut -c1-40; }
disk()    { df -h / 2>/dev/null | awk 'NR==2{printf "%s free / %s", $4, $2}'; }
gpu()     {
  lspci 2>/dev/null | grep -iE 'vga|3d|display' | sed 's/.*: //' | head -1 | cut -c1-40 \
    || echo "unknown"
}
user_host(){ printf '%s@%s' "${USER:-root}" "$(hostname -s 2>/dev/null || echo neoos)"; }

full() {
  local rows=(
    "OS:        $(os_pretty)"
    "Host:      $(user_host)"
    "Kernel:    $(kernel)"
    "Uptime:    $(uptime_s)"
    "Packages:  $(packages)"
    "Shell:     $(shell)"
    "Memory:    $(memory)"
    "Disk:      $(disk)"
    "CPU:       $(cpu)"
    "GPU:       $(gpu)"
  )
  local w=0
  for ((i=0;i<${#logo[@]};i++)); do ((${#logo[i]}>w)) && w=${#logo[i]}; done
  local color=36 cyan=96 dim=2
  local lcolor=32
  for ((i=0;i<${#rows[@]};i++)); do
    if ((i < ${#logo[@]})); then
      printf "\033[1;${lcolor}m%s\033[0m  \033[${color}m%s\033[0m\n" "${logo[i]}" "${rows[i]}"
    else
      printf "%${w}s  \033[${dim}m%s\033[0m\n" "" "${rows[i]}"
    fi
  done
}

min() {
  printf '%s | %s | kernel %s | %s | %s\n' \
    "$(os_pretty)" "$(user_host)" "$(kernel)" "$(packages)" "$(memory)"
}

only_logo() {
  for l in "${logo[@]}"; do printf "\033[1;32m%s\033[0m\n" "$l"; done
}

case "${1:-full}" in
  --min|-m) min ;;
  --logo)   only_logo ;;
  *)        full ;;
esac
