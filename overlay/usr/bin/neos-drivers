#!/usr/bin/env bash
# neos-drivers — NeoOS hardware driver installer.
# Detects hardware, enables the non-free-firmware component, and installs
# firmware, GPU, wifi, bluetooth and audio drivers.

set -euo pipefail

log() { printf '\033[1;32m[neos-drivers]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[neos-drivers]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[neos-drivers]\033[0m %s\n' "$*" >&2; }

need_root() {
  if [[ $EUID -ne 0 ]]; then
    if command -v sudo >/dev/null 2>&1; then
      exec sudo "$0" "$@"
    else
      err "This tool needs root. Run with sudo or as root."
      exit 1
    fi
  fi
}

ensure_nonfree_firmware() {
  local sl=/etc/apt/sources.list
  local d=/etc/apt/sources.list.d/neoos-firmware.list
  if ! grep -q "non-free-firmware" "$sl" 2>/dev/null && [[ ! -f "$d" ]]; then
    log "Enabling non-free-firmware component"
    cp "$sl" "$sl.bak" 2>/dev/null || true
    sed -i 's/ main / main contrib non-free-firmware /; s/ main$/ main contrib non-free-firmware/' "$sl"
    apt-get update
  fi
}

detect_hardware() {
  log "Hardware detection:"
  echo "  -- CPU --"
  grep -m1 "model name" /proc/cpuinfo | sed 's/^model name\s*:\s*/     /'
  echo "  -- PCI devices --"
  (lspci 2>/dev/null | head -20 || echo "     (lspci not available)") | sed 's/^/     /'
  echo "  -- USB devices --"
  (lsusb 2>/dev/null | head -12 || echo "     (lsusb not available)") | sed 's/^/     /'
}

install_gpu() {
  ensure_nonfree_firmware
  # Detect discrete GPU vendor
  if lspci 2>/dev/null | grep -qi "NVIDIA"; then
    log "NVIDIA GPU detected"
    apt-get install -y nvidia-driver nvidia-settings 2>/dev/null \
      || warn "nvidia-driver unavailable; falling back to mesa"
  fi
  if lspci 2>/dev/null | grep -qiE "AMD|ATI|Radeon"; then
    log "AMD GPU detected"
    apt-get install -y firmware-amd-graphics mesa-vulkan-drivers libgl1-mesa-dri
  fi
  log "Installing Mesa / Vulkan stack (works for all GPUs)"
  apt-get install -y mesa-utils mesa-vulkan-drivers libgl1-mesa-dri libvulkan1 vulkan-tools
}

install_wifi() {
  ensure_nonfree_firmware
  log "Installing network firmware + tools"
  apt-get install -y firmware-linux firmware-misc-nonfree wireless-tools iw rfkill wpasupplicant \
    network-manager network-manager-wifi
  warn "Re-check connectivity after reboot; use nmcli to connect to WiFi."
}

install_bluetooth() {
  ensure_nonfree_firmware
  log "Installing bluetooth stack"
  apt-get install -y bluez bluez-tools firmware-linux
}

install_audio() {
  log "Installing audio stack"
  apt-get install -y alsa-utils pulseaudio pulseaudio-utils 2>/dev/null \
    || apt-get install -y alsa-utils pipewire pipewire-pulse 2>/dev/null \
    || warn "No audio stack could be installed"
}

install_printer() {
  ensure_nonfree_firmware
  log "Installing printing stack"
  apt-get install -y cups printer-driver-all firmware-printer
}

install_firmware() {
  ensure_nonfree_firmware
  log "Installing generic Linux firmware"
  apt-get install -y firmware-linux firmware-linux-nonfree firmware-misc-nonfree
}

menu() {
  local choice
  choice=$(whiptail --title "NeoOS Driver Installer" --menu \
    "Detected hardware and driver options" 22 74 14 \
    "Detect"     "Show detected hardware (lspci/lsusb)" \
    "All"        "Install everything below (recommended)" \
    "GPU"        "Mesa, Vulkan, AMD/NVIDIA firmware" \
    "WiFi"       "Wireless firmware, wpa_supplicant, NetworkManager" \
    "Bluetooth"  "BlueZ stack + firmware" \
    "Audio"      "ALSA + PipeWire/PulseAudio" \
    "Printer"    "CUPS + printer drivers" \
    "Firmware"   "Generic Linux firmware (broadcom, rtl, etc.)" \
    "Cancel"     "Exit" 3>&1 1>&2 2>&3)
  case "$choice" in
    Detect) detect_hardware; read -r -p "Press Enter to continue...";;
    All) install_gpu; install_wifi; install_bluetooth; install_audio; install_printer; install_firmware;;
    GPU) install_gpu;;
    WiFi) install_wifi;;
    Bluetooth) install_bluetooth;;
    Audio) install_audio;;
    Printer) install_printer;;
    Firmware) install_firmware;;
    *) exit 0;;
  esac
  log "Done."
}

if [[ "${1:-}" == "--detect" ]]; then
  detect_hardware
  exit 0
fi

need_root
if command -v whiptail >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" || -n "${TERM:-}" ]]; then
  menu
else
  detect_hardware
  echo
  warn "No interactive menu available; install manually:"
  echo "  neos-drivers --detect"
fi
