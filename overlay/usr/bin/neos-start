#!/usr/bin/env bash
# neos-start — NeoOS start menu (Windows-like). Launch apps, open files,
# reach settings, or power off. Uses whiptail/dialog if a TTY; otherwise
# prints a numbered list and (for --list-*) machine-readable entries.
#
#   neos-start            show the start menu
#   neos-start apps       list launchable applications
#   neos-start --list-apps      machine-readable app list (name<TAB>cmd)
#   neos-start --list-settings  machine-readable settings list (name<TAB>cmd)

set -uo pipefail

# Pick a menu backend (whiptail preferred, dialog fallback) — same as neos-menu.
if command -v whiptail >/dev/null 2>&1; then
  MENU=whiptail
elif command -v dialog >/dev/null 2>&1; then
  MENU=dialog
else
  MENU=""
fi

color() { printf '\033[1;%sm%s\033[0m\n' "$1" "$2"; }
log()  { printf '\033[1;36m[neos-start]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[neos-start]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[neos-start]\033[0m %s\n' "$*" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }
have_tty() { [[ -t 0 && -t 2 ]]; }

# --- application discovery -------------------------------------------------

# desktop_name <file>  -> first non-empty Name=
desktop_name() {
  local f="$1" k v
  while IFS='=' read -r k v; do
    case "$k" in Name) printf '%s' "$v"; return 0;; esac
  done < "$f"
}

# desktop_exec <file> -> first Exec= (stripped of field codes like %f)
desktop_exec() {
  local f="$1" k v
  while IFS='=' read -r k v; do
    case "$k" in Exec) v="${v%%%*}"; printf '%s' "$v"; return 0;; esac
  done < "$f"
}

# apps_iter -> prints "name<TAB>exec" for installed desktop apps (capped)
apps_iter() {
  local f name exec seen=0
  for f in /usr/share/applications/*.desktop; do
    [[ -r "$f" ]] || continue
    [[ "$f" == *"-desktop"* ]] && continue   # skip the wrapper
    name="$(desktop_name "$f")"
    exec="$(desktop_exec "$f")"
    [[ -z "$name" || -z "$exec" ]] && continue
    grep -qi '^NoDisplay=true' "$f" && continue
    printf '%s\t%s\n' "$name" "$exec"
    seen=$((seen+1))
    if (( seen >= 25 )); then break; fi
  done
  return 0
}

# --- launch helpers --------------------------------------------------------

launch_app() { # launch_app <exec-line>
  local exec="$1" cmd
  cmd="${exec%% *}"           # first token is the binary
  if ! have "$cmd" && ! have "$(basename "$cmd")"; then
    warn "application not installed: $cmd"
    return 1
  fi
  log "launching: $exec"
  setsid $exec >/dev/null 2>&1 < /dev/null &
  disown 2>/dev/null || true
}

open_files() {
  if have pcmanfm;    then setsid pcmanfm "$PWD" >/dev/null 2>&1 </dev/null &
  elif have xdg-open; then setsid xdg-open "$PWD" >/dev/null 2>&1 </dev/null &
  else warn "no file manager found (install pcmanfm or xdg-open)."; return 1; fi
  disown 2>/dev/null || true
}

# --- settings registry (name<TAB>command) ---------------------------------

settings_iter() {
  cat <<'EOF'
Health	check	neos doctor
Drivers	neos-drivers
Packages	pkg list
Users	neos-users status
Language	neos-lang list
Network	neos-net
Disk	neos-disk
Wayland	neos-wayland
Wine	neos-wine --install
Terminal (Win)+	neos-winevm create win10
System monitor	neos-monitor
Updater	neos-update
EOF
}

# --- menu engine -----------------------------------------------------------

box() { # box <title> <prompt> <height> <width> <max> <t1> <d1> ...
  local title="$1" prompt="$2" h="$3" w="$4" m="$5"; shift 5
  if [[ "$MENU" == "dialog" ]]; then
    dialog --title "$title" --menu "$prompt" "$h" "$w" "$m" "$@"
  else
    whiptail --title "$title" --menu "$prompt" "$h" "$w" "$m" "$@"
  fi
}

choose() { # choose <title> <prompt> <max> <t1> <d1> <t2> <d2> ... -> tag on stdout
  local title="$1" prompt="$2" max="$3"; shift 3
  if have_tty && [[ -n "$MENU" ]]; then
    box "$title" "$prompt" 20 70 "$max" "$@" 3>/dev/tty
    return $?
  fi
  # non-TTY: numbered list, read a number from stdin
  local i=1
  printf '%s:\n' "$prompt" >&2
  while [[ $# -ge 2 ]]; do
    printf '  %d) %s\n' "$i" "$2" >&2
    _tags["$i"]="$1"
    i=$((i+1)); shift 2
  done
  local ans
  read -r -p "choose [1-$((i-1))]: " ans >&2 || return 1
  [[ "$ans" =~ ^[0-9]+$ ]] || return 1
  (( ans >= 1 && ans < i )) || return 1
  printf '%s' "${_tags[$ans]}"
}
declare -A _tags=()

main_menu() {
  local choice
  choice="$(choose "NeoOS Start" "Select a category:" 4 \
    Apps       "Applications (browser, editor, ...)" \
    Files      "Open file manager here" \
    Settings   "Settings & tools (health, drivers, ...)" \
    Power      "Power: shutdown / reboot / logout")"
  [[ -n "$choice" ]] || return 0
  case "$choice" in
    Apps)      app_menu ;;
    Files)     open_files ;;
    Settings)  settings_menu ;;
    Power)     power_menu ;;
  esac
}

app_menu() {
  local name exec
  local items=()
  while IFS=$'\t' read -r name exec; do
    [[ -z "$name" ]] && continue
    items+=("$name" "$exec")
  done < <(apps_iter)
  if [[ ${#items[@]} -eq 0 ]]; then
    warn "no desktop applications found."; return 0
  fi
  local sel
  sel="$(choose "Applications" "Select an app:" "${#items[@]}" "${items[@]}")"
  [[ -z "$sel" ]] && return 0
  launch_app "$sel"
}

settings_menu() {
  local name cmd items=()
  while IFS=$'\t' read -r name cmd; do
    [[ -z "$name" ]] && continue
    items+=("$name" "$cmd")
  done < <(settings_iter)
  local sel
  sel="$(choose "Settings" "Select a tool:" "${#items[@]}" "${items[@]}")"
  [[ -z "$sel" ]] && return 0
  log "running: $sel"
  # run in background so the menu can return
  setsid $sel >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
}

power_menu() {
  local choice
  choice="$(choose "Power" "Choose an action:" 3 \
    Shutdown "Power off now" \
    Reboot   "Restart now" \
    Logout   "Return to login / exit session")"
  [[ -n "$choice" ]] || return 0
  case "$choice" in
    Shutdown) have systemctl && systemctl poweroff || { warn "systemctl not available."; exit 1; } ;;
    Reboot)   have systemctl && systemctl reboot   || { warn "systemctl not available."; exit 1; } ;;
    Logout)   if [[ -n "${XDG_SESSION_TYPE:-}" || -n "${DISPLAY:-}" ]]; then
                if have loginctl; then loginctl terminate-user "$USER" || log "logout requested."
                else log "logout: exit your shell or run 'exit'."; fi
              else log "logout: not in a graphical session."; fi ;;
  esac
}

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  case "${1:-}" in
    ""|menu) main_menu ;;
    apps)   apps_iter ;;
    --list-apps)      apps_iter ;;
    --list-settings)  settings_iter ;;
    -h|--help) usage ;;
    *) err "unknown argument: $1"; usage; return 2 ;;
  esac
}

main "$@"
