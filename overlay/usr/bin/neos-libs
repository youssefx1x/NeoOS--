#!/usr/bin/env bash
# neos-libs — NeoLIBs native C-library API (libneo.so / NeoAPI) status
set -euo pipefail
LIB="/usr/lib/libneo.so"
case "${1:-status}" in
  status)
    echo "NeoLIBs native core (NeoAPI ${NEOAPI_VERSION:-1.2.0}):"
    for f in "$LIB" "$LIB.1" "$LIB.1.2.0"; do
      [[ -e "$f" ]] && printf '  %s (%s bytes)\n' "$f" "$(stat -c%s "$f" 2>/dev/null || echo '?')"
    done
    [[ -e /usr/include/neo/neo.h ]] && echo "  header: /usr/include/neo/neo.h"
    command -v pkg-config >/dev/null 2>&1 && pkg-config --modversion neoapi 2>/dev/null || true
    ;;
  list|ls) ls -l /usr/lib/libneo* 2>/dev/null || echo "no libneo found" ;;
  *) echo "usage: neos-libs [status|list]" >&2; exit 2 ;;
esac
