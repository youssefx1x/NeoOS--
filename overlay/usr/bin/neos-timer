#!/usr/bin/env bash
# neos-timer — countdown and pomodoro timer with a bell alert.
#   neos-timer 5m            count down 5 minutes
#   neos-timer 90s           count down 90 seconds
#   neos-timer pomodoro      25 min focus + 5 min break (x4)
#   neos-timer --message txt custom completion message
# Times accept a suffix: s, m, h.

set -euo pipefail

MSG="Timer done"
MODE=countdown
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --message) MSG="${2:-Timer done}"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^#   /  /; s/^#//'; exit 0 ;;
    --version|-v) echo "neos-timer ${NEOS_VERSION:-1.2.0}"; exit 0 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

parse() {
  local t="$1"
  case "$t" in
    *h) echo $(( ${t%h} * 3600 )) ;;
    *m) echo $(( ${t%m} * 60 )) ;;
    *s) echo $(( ${t%s} )) ;;
    *)  echo "$t" ;;
  esac
}

bell() {
  printf '\a'
  for _ in 1 2 3; do printf '\a'; sleep 0.4; done
}

countdown() {
  local total="$1" left
  left="$total"
  printf 'Countdown: %s\n' "${2:-}"
  while (( left > 0 )); do
    printf '\r  %02d:%02d remaining ' $((left/60)) $((left%60))
    sleep 1
    left=$((left-1))
  done
  printf '\r  done!              \n'
  bell
  echo "$MSG"
}

pomodoro() {
  for ((i=1; i<=4; i++)); do
    echo "Pomodoro $i/4 — focus 25 min"
    countdown 1500 "Focus (25 min)"
    echo "Break 5 min"
    countdown 300 "Break"
  done
  echo "Pomodoro session complete!"
}

if [[ "${ARGS[0]:-}" == "pomodoro" ]]; then
  pomodoro
else
  total=$(parse "${ARGS[0]:-5m}")
  countdown "$total" "${ARGS[1]:-}"
fi
