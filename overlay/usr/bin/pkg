#!/usr/bin/env bash
# pkg — NeoPkg 2.0: NeoOS unified package manager.
#
# Over apt/dpkg with multi-source discovery (apt, Flatpak, local AppImages,
# Wine .lnk apps), plus transactional history, snapshots and rollback,
# package verification, repository priorities and an offline cache.
#
#   pkg update              refresh package lists (apt update)
#   pkg upgrade             upgrade all upgradable packages (snapshot+rollback ready)
#   pkg install <pkgs...>   install packages (snapshot before, rollback on failure) (alias: -i)
#   pkg remove <pkgs...>    remove packages (snapshot before, autoremove)
#   pkg purge <pkgs...>     remove + delete config
#   pkg search <term>       search apt + flatpak + appimage + wine  (alias: -S)
#   pkg show <pkg>          detailed info (apt/flatpak/appimage/exe) (alias: -s)
#   pkg files <pkg>         list files owned by an installed package
#   pkg depends <pkg>       show a package's dependencies           (alias: -d)
#   pkg list                list installed packages (count + names) (alias: -L)
#   pkg list-all            list all known packages
#   pkg check               dpkg --audit (broken packages)
#   pkg verify <pkg| --all> verify installed file checksums (debsums) (alias: -V)
#   pkg priority <expr>     list or append an apt pinning priority   (alias: -P)
#   pkg offline-cache on|off|status  keep downloaded debs for offline installs
#   pkg autoremove          remove no-longer-needed packages         (alias: -a)
#   pkg clean               clean the apt cache                      (alias: -c)
#   pkg doctor              health check: apt/dpkg/broken/partial/held/snapshots
#   pkg rollback [id]       revert to the last transaction snapshot
#   pkg history             list recorded install/remove/upgrade transactions
#   pkg self-update         update NeoOS's own tools/scripts (NEOS_REPO/NEOS_GH)
#   pkg version             print pkg + OS version                   (alias: -v)
#   pkg help                show this help
#
# Flag aliases never collide: -i=install, -S=search, -s=show, -d=depends,
# -L=list, -a=autoremove, -c=clean, -v=version, -V=verify, -P=priority.
# Exit codes follow apt conventions (0 ok, 100 on user cancel).

set -euo pipefail

NEOS_REPO="${NEOS_REPO:-/opt/neos}"
NEOS_GH="${NEOS_GH:-}"

# --- NeoPkg 2.0 shared state ----------------------------------------------------
NEOPKG_STATE="${NEOPKG_STATE:-/var/lib/neopkg}"
NEOPKG_LOG="${NEOPKG_LOG:-/var/log/neopkg.history}"
NEOPKG_SNAPS="$NEOPKG_STATE/snapshots"
NEOPKG_OFFLINE="${NEOPKG_OFFLINE:-$NEOPKG_STATE/offline-cache}"
mkdir -p "$NEOPKG_STATE" "$NEOPKG_SNAPS" 2>/dev/null || true

log() { printf '\033[1;36m[pkg]\033[0m %s\n' "$*"; }
info(){ printf '\033[1;32m[pkg]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[pkg]\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m[pkg]\033[0m %s\n' "$*" >&2; }
good(){ printf '\033[1;32m[ok]\033[0m   %s\n' "$*"; }

run_root() {
  if [[ $EUID -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    err "root required for: $*"
    exit 1
  fi
}

# Record a transaction line (idempotent append; silent if log not writable).
neopkg_log() {
  local action="$1"; shift
  {
    printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$$" "$action $*"
  } >> "$NEOPKG_LOG" 2>/dev/null || true
}

# Snapshot dpkg selection+versions before a mutating transaction; echoes snapshot id.
neopkg_snapshot() {
  local label="$1"; shift
  local ts id
  ts="$(date '+%s')"
  id="$(printf '%s-%s' "$ts" "$$")"
  {
    printf '# %s %s\n' "$label" "$(date '+%Y-%m-%dT%H:%M:%S%z')"
    printf -- '---selections---\n'
    dpkg --get-selections 2>/dev/null || true
    printf -- '---versions---\n'
    dpkg-query -W -f='${Package}\t${Version}\n' 2>/dev/null || true
    printf -- '---manual---\n'
    apt-mark showmanual 2>/dev/null || true
    printf -- '---args---\n%s\n' "$label $*"
  } > "$NEOPKG_SNAPS/snap-$id.txt" 2>/dev/null || true
  printf '%s' "$id"
}

# Revert to snapshot <id> (default: newest). Downgrade versions + remove extras.
neopkg_rollback() {
  local id="${1:-}" snap
  if [[ -z "$id" ]]; then
    snap="$(ls -1t "$NEOPKG_SNAPS"/snap-*.txt 2>/dev/null | head -n1)"
  else
    snap="$NEOPKG_SNAPS/snap-$id.txt"
  fi
  [[ -f "$snap" ]] || { err "no snapshot found for '$id'"; return 1; }
  log "Reverting to snapshot: $(basename "$snap")"

  local in_sel=0 in_vers=0 line pkg ver
  local -A old_sel old_vers
  while IFS= read -r line; do
    case "$line" in
      "---selections---") in_sel=1; in_vers=0; continue;;
      "---versions---")   in_vers=1; in_sel=0; continue;;
      "---manual---")     in_vers=0; in_sel=0; continue;;
      "---args---")       break;;
    esac
    if (( in_sel )); then
      pkg="${line%%.*}"; [[ -n "$pkg" ]] && old_sel["$pkg"]=1
    elif (( in_vers )); then
      pkg="${line%%$'\t'*}"
      ver="${line#*$'\t'}"
      [[ -n "$pkg" && -n "$ver" ]] && old_vers["$pkg"]="$ver"
    fi
  done < "$snap"

  local -A now_vers
  while IFS=$'\t' read -r pkg ver; do now_vers["$pkg"]="$ver"; done \
    < <(dpkg-query -W -f='${Package}\t${Version}\n' 2>/dev/null || true)

  local did=0
  for pkg in "${!now_vers[@]}"; do
    if [[ -z "${old_sel[$pkg]:-}" ]]; then
      log "removing (pulled in since snapshot): $pkg"
      apt-get remove -y "$pkg" >/dev/null 2>&1 && did=1 || true
    fi
  done
  for pkg in "${!old_vers[@]}"; do
    ver="${old_vers[$pkg]}"
    if [[ -n "${now_vers[$pkg]:-}" && "${now_vers[$pkg]}" != "$ver" ]]; then
      log "downgrading $pkg ${now_vers[$pkg]} -> $ver"
      apt-get install -y --allow-downgrades "$pkg=$ver" >/dev/null 2>&1 && did=1 || true
    fi
  done
  if (( did )); then
    apt-get autoremove -y >/dev/null 2>&1 || true
    good "rollback applied"
  else
    good "no version changes to revert"
  fi
}

usage() { sed -n '2,37p' "$0" | sed 's/^#   /  /; s/^#//'; }

# --- NeoPkg 2.0: package verification (debsums) --------------------------------
neopkg_verify() {
  local pkg="${1:-}"
  if [[ -z "$pkg" || "$pkg" == "--all" ]]; then
    if ! command -v debsums >/dev/null 2>&1; then
      err "debsums not installed; run: pkg install debsums"
      return 1
    fi
    run_root debsums -c 2>/dev/null && good "all packages verified OK" || {
      warn "checksum mismatches found (see debsums output above)"
      return 1
    }
    neopkg_log verify "--all"
  else
    dpkg-query -W -f='${Package}\n' "$pkg" >/dev/null 2>&1 || {
      err "package '$pkg' not installed"; return 1; }
    if ! command -v debsums >/dev/null 2>&1; then
      err "debsums not installed; run: pkg install debsums"
      return 1
    fi
    run_root debsums "$pkg" 2>/dev/null && good "verified: $pkg" || {
      warn "mismatches for '$pkg'"
      return 1
    }
    neopkg_log verify "$pkg"
  fi
}

# --- NeoPkg 2.0: repository priorities (apt pinning) ---------------------------
neopkg_priority() {
  local expr="${1:-}"
  if [[ -z "$expr" ]]; then
    log "Current NeoPkg apt priorities:"
    [[ -f /etc/apt/preferences.d/neopkg-local ]] && cat /etc/apt/preferences.d/neopkg-local || true
    return 0
  fi
  local pinfile="$NEOPKG_STATE/priorities.conf"
  mkdir -p "$NEOPKG_STATE"
  printf '%s\n' "$expr" >> "$pinfile"
  if [[ $EUID -eq 0 ]]; then
    cp "$pinfile" /etc/apt/preferences.d/neopkg-local 2>/dev/null || true
  elif command -v sudo >/dev/null 2>&1; then
    sudo cp "$pinfile" /etc/apt/preferences.d/neopkg-local 2>/dev/null || true
  fi
  good "priority appended to /etc/apt/preferences.d/neopkg-local"
  neopkg_log priority "$expr"
}

# --- NeoPkg 2.0: offline cache (keep downloaded debs) --------------------------
neopkg_offline_cache() {
  local sub="${1:-status}"
  case "$sub" in
    on|enable)
      mkdir -p "$NEOPKG_OFFLINE"
      run_root mkdir -p /var/cache/apt/archives
      good "offline cache enabled at $NEOPKG_OFFLINE (apt archives retained)"
      neopkg_log offline-cache on
      ;;
    off|disable)
      run_root rm -rf "$NEOPKG_OFFLINE" 2>/dev/null || true
      warn "offline cache disabled"
      neopkg_log offline-cache off
      ;;
    status)
      if [[ -d "$NEOPKG_OFFLINE" ]]; then
        good "offline cache: ENABLED ($NEOPKG_OFFLINE)"
      else
        info "offline cache: disabled (run 'pkg offline-cache on' to retain debs)"
      fi
      ;;
    *)
      err "usage: pkg offline-cache on|off|status"; return 2
      ;;
  esac
}

# --- multi-source discovery helpers --------------------------------------------
_neo_appimage_dir() { grep -E '^NEOPKG_APPDIR=' "$NEOPKG_STATE/neopkg.env" 2>/dev/null | cut -d= -f2 || true; }
_neo_win_prefix()   { ls -d "$WINEPREFIX" "$HOME/.wine" 2>/dev/null | head -1; }

neo_search() {
  local term="${1:-}"
  [[ -n "$term" ]] || { err "usage: pkg search <term>"; return 2; }
  local n=0 m
  while IFS= read -r m; do [[ -n "$m" ]] && { printf 'apt:    %s\n' "$m"; n=$((n+1)); }; done \
    < <(apt-cache search "$term" 2>/dev/null | head -30)
  if command -v flatpak >/dev/null 2>&1; then
    while IFS= read -r m; do [[ -n "$m" ]] && { printf 'flatpak: %s\n' "$m"; n=$((n+1)); }; done \
      < <(flatpak search "$term" 2>/dev/null | tail -n +2 | head -20)
  fi
  local d; d="${NEOPKG_APPDIR:-$HOME/Applications}"
  if [[ -d "$d" ]]; then
    while IFS= read -r -d '' f; do
      m="$(basename "$f")"
      case "$m" in *"$term"*) printf 'appimg:  %s\n' "$m"; n=$((n+1));; esac
    done < <(find "$d" -maxdepth 1 -type f -name '*.AppImage' -print0 2>/dev/null)
  fi
  local wprefix; wprefix="$(_neo_win_prefix)"
  if [[ -n "$wprefix" ]]; then
    local lf
    for lf in "$wprefix"/drive_c/**/*.desktop "$HOME/.local/share/Trash/files"/*.desktop; do
      [[ -e "$lf" ]] || continue
      if grep -qi "Name=$term" "$lf" 2>/dev/null; then printf 'wine:   %s\n' "$(basename "$lf")"; n=$((n+1)); fi
    done 2>/dev/null || true
  fi
  (( n > 0 )) || { warn "no matches for '$term'"; if ! apt-cache policy 2>/dev/null | grep -q "http"; then
    cat >&2 <<EOF
Hint: no APT sources look to be online. Run: sudo apt update
EOF
  fi; }
}

neo_show() {
  local pkg="${1:-}"
  [[ -n "$pkg" ]] || { err "usage: pkg show <package>"; return 2; }
  local found=0
  if apt-cache show "$pkg" >/dev/null 2>&1; then
    apt-cache show "$pkg" 2>/dev/null | head -40
    found=1
  fi
  if command -v flatpak >/dev/null 2>&1 && flatpak info "$pkg" >/dev/null 2>&1; then
    flatpak info "$pkg" 2>/dev/null; found=1
  fi
  if [[ -f "$pkg" && -x "$pkg" && "$(head -c4 "$pkg")" == "#!/"* ]]; then
    file "$pkg"; found=1
  fi
  (( found )) || warn "no package/app named '$pkg' found (apt/flatpak/appimage)"
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  update|-u)
    log "Updating package lists..."
    run_root apt update
    neopkg_log update
    info "Done. Run 'pkg upgrade' to apply updates."
    ;;

  upgrade|-up|full-upgrade|dist-upgrade)
    snap="$(neopkg_snapshot upgrade "$@")"
    log "Upgrading all upgradable packages..."
    if run_root apt-get upgrade -y; then
      good "Upgrade complete."
      neopkg_log upgrade "$snap"
    else
      warn "Upgrade had issues; previous state was snapshotted: $snap"
      neopkg_log upgrade-failed "$snap $*"
    fi
    ;;

  install|add|-i)
    [[ $# -gt 0 ]] || { err "usage: pkg install <package>..."; exit 2; }
    snap="$(neopkg_snapshot install "$@")"
    if run_root apt install -y "$@"; then
      good "Installed: $*"
      neopkg_log install "$snap $*"
    else
      err "install failed; snapshot available: $snap"
      neopkg_log install-failed "$snap $*"
      exit 1
    fi
    ;;

  remove|uninstall|-r)
    [[ $# -gt 0 ]] || { err "usage: pkg remove <package>..."; exit 2; }
    snap="$(neopkg_snapshot remove "$@")"
    if run_root apt remove -y "$@"; then
      good "Removed: $*"
      neopkg_log remove "$snap $*"
      run_root apt autoremove -y >/dev/null 2>&1 || true
    else
      warn "remove had issues; snapshot available: $snap"
      neopkg_log remove-failed "$snap $*"
    fi
    ;;

  purge)
    [[ $# -gt 0 ]] || { err "usage: pkg purge <package>..."; exit 2; }
    snap="$(neopkg_snapshot purge "$@")"
    run_root apt purge -y "$@"
    neopkg_log purge "$snap $*"
    ;;

  search|find|-S)
    neo_search "$@";;

  show|info|-s)
    neo_show "$@";;

  files)
    [[ $# -gt 0 ]] || { err "usage: pkg files <installed-package>"; exit 2; }
    dpkg -L "$@"
    ;;

  depends|deps|-d)
    [[ $# -gt 0 ]] || { err "usage: pkg depends <package>"; exit 2; }
    apt-cache depends "$@"
    ;;

  list|list-installed|-L)
    n=$(dpkg-query -W -f='${Package}\n' 2>/dev/null | wc -l)
    info "$n packages installed:"
    dpkg-query -W -f='${Package} ${Version}\n' 2>/dev/null | sort
    ;;

  list-all)
    apt-cache pkgnames 2>/dev/null | sort
    ;;

  check|audit)
    run_root dpkg --audit
    info "dpkg audit done."
    ;;

  verify|--verify|-V|checksum)
    neopkg_verify "$@";;

  priority|--priority|-P)
    neopkg_priority "$@";;

  offline-cache|offline)
    neopkg_offline_cache "$@";;

  autoremove|-a)
    snap="$(neopkg_snapshot autoremove "$@")"
    run_root apt autoremove -y
    neopkg_log autoremove "$snap"
    ;;

  clean|-c)
    run_root apt-get clean
    info "Cache cleaned."
    neopkg_log clean
    ;;

  doctor)
    pass=0; fail=0
    _ck() { local desc="$1"; shift; if "$@"; then good "$desc"; pass=$((pass+1)); else err "$desc"; fail=$((fail+1)); fi; }
    _ck "apt lists present"    test -d /var/lib/apt/lists
    _ck "dpkg audit clean"     sh -c 'dpkg --audit 2>&1 | grep -q . && exit 1 || exit 0'
    _ck "no broken deps"       sh -c 'apt-get -s -f install >/dev/null 2>&1'
    _ck "root disk <95% full"  sh -c 'df / | awk "NR==2{exit !(\$5+0<95)}"'
    _ck "network reachable"   test -n "$(getent hosts deb.debian.org 2>/dev/null)"
    _ck "snapshots writable"  test -d "$NEOPKG_SNAPS"
    snapc="$(find "$NEOPKG_SNAPS" -name 'snap-*.txt' 2>/dev/null | wc -l)"
    printf 'snapshots      : %s\n' "$snapc"
    echo
    printf 'NeoPkg doctor: %d passed, %d failed\n' "$pass" "$fail"
    [[ $fail -eq 0 ]]
    ;;

  rollback)
    neopkg_rollback "${1:-}";;

  history)
    if [[ -r "$NEOPKG_LOG" ]]; then
      echo "NeoPkg transaction history ($NEOPKG_LOG):"
      tail -n 50 "$NEOPKG_LOG" | while IFS=$'\t' read -r ts pid rest; do
        printf '  %s  [%s] %s\n' "$ts" "${pid:-}" "$rest"
      done
      echo "snapshots: $(find "$NEOPKG_SNAPS" -name 'snap-*.txt' 2>/dev/null | wc -l)"
    else
      echo "no transactions recorded yet"
    fi
    ;;

  self-update|selfupdate)
    if [[ ! -d "$NEOS_REPO/.git" ]]; then
      if [[ -n "${NEOS_GH:-}" ]] && command -v git >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1; then
        log "Cloning NeoOS tools repo to $NEOS_REPO"
        sudo mkdir -p "$(dirname "$NEOS_REPO")"
        sudo git clone "$NEOS_GH" "$NEOS_REPO"
      else
        err "Set NEOS_REPO=<path> (a git checkout of the NeoOS tools repo),"
        err "or NEOS_GH=<git-url> to clone on first use, then retry 'pkg self-update'."
        err "The tools repo must contain an 'overlay/' dir and 'scripts/apply-overlay.sh'."
        exit 1
      fi
    fi
    log "Updating NeoOS tools from $NEOS_REPO"
    git -C "$NEOS_REPO" pull --ff-only
    if [[ -f "$NEOS_REPO/scripts/apply-overlay.sh" ]]; then
      run_root bash "$NEOS_REPO/scripts/apply-overlay.sh" /
    fi
    info "NeoOS tools updated. Restart any open shells."
    ;;

  version|-v|--version)
    echo "pkg (NeoPkg 2.0) — NeoOS package manager"
    cat /etc/os-release 2>/dev/null | grep -E '^(NAME|VERSION|ID|VERSION_ID)=' | sed 's/^/  /' || true
    echo "  apt version: $(apt --version 2>/dev/null | head -1)"
    echo "  pkg script:  $0"
    snapc="$(find "$NEOPKG_SNAPS" -name 'snap-*.txt' 2>/dev/null | wc -l)"
    echo "  snapshots  : $snapc"
    ;;

  help|-h|--help|"")
    usage
    ;;
  *)
    err "unknown command: $cmd"
    usage
    exit 2
    ;;
esac
