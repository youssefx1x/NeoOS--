#!/usr/bin/env bash
# neos-recovery — NeoRecovery: snapshot restore & rollback entry point
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
resolve() { command -v "$1" 2>/dev/null || echo "$SELF_DIR/$1"; }

case "${1:-status}" in
  status|snapshots) "$(resolve neos-snapshots)" ;;
  rollback|restore) id="${2:-}"; [[ -z "$id" ]] && { echo "usage: neos-recovery rollback <id>" >&2; exit 2; }
    "$(resolve neos-pkg)" rollback "$id" 2>/dev/null || echo "no rollback target — see 'neos-snapshots'" ;;
  boot) echo "neos-recovery boot: reboot into recovery (not configured)" >&2; exit 1 ;;
  *) echo "usage: neos-recovery [status|rollback <id>|boot]" >&2; exit 2 ;;
esac
