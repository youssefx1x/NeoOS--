#!/usr/bin/env bash
# neos-mirror — switch NeoOS apt sources to the centralized mirror endpoint.
#   neos-mirror status   show whether the mirror is active
#   neos-mirror apply    write the mirror sources list and refresh apt
#   neos-mirror revert   remove the mirror sources list and refresh apt
# Endpoint is configurable: NEOS_MIRROR_URL=https://mirror.example/debian
set -euo pipefail

MIRROR="${NEOS_MIRROR_URL:-https://dl.neoos.local/debian}"
OVERLAY=/etc/apt/sources.list.d/neoos-mirror.list
SUITE="${NEOS_DISTRO_SUITE:-trixie}"

log()  { printf '\033[1;35m[neos-mirror]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[neos-mirror]\033[0m %s\n' "$*" >&2; }

need_root() {
  if [[ $EUID -ne 0 ]]; then
    if command -v sudo >/dev/null 2>&1; then exec sudo "$0" "$@"; fi
    warn "needs root. re-run with sudo."
    exit 1
  fi
}

do_update() {
  command -v apt-get >/dev/null 2>&1 && apt-get update || warn "apt-get update failed"
}

case "${1:-status}" in
  status)
    if [[ -f "$OVERLAY" ]]; then
      log "mirror active:"
      sed 's/^/  /' "$OVERLAY"
    else
      log "mirror not configured (using default sources.list)"
    fi
    ;;
  apply)
    need_root "$@"
    log "writing $OVERLAY -> $MIRROR ($SUITE)"
    printf 'deb %s %s main contrib non-free-firmware\n' "$MIRROR" "$SUITE" > "$OVERLAY"
    do_update
    ;;
  revert)
    need_root "$@"
    if [[ -f "$OVERLAY" ]]; then
      rm -f "$OVERLAY"
      log "mirror sources removed"
      do_update
    else
      log "nothing to revert"
    fi
    ;;
  -h|--help|"")
    sed -n '2,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "usage: neos-mirror {status|apply|revert}" >&2
    exit 2
    ;;
esac
