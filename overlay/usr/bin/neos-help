#!/usr/bin/env bash
# neos-help — NeoOS command reference. Lists every NeoOS tool with a
# one-line summary, or full usage for a single command.
#   neos-help                 overview of all NeoOS commands
#   neos-help <command>       full usage of one command
#   neos-help --all           detailed usage of every command
#   neos-help --list          just the command names

set -euo pipefail

BANNER='NeoOS 1.1.0 Stable — terminal-first Debian 13 distribution'

one() {
  local cmd="$1" line="$2"
  printf '  \033[1;32m%-16s\033[0m %s\n' "$cmd" "$line"
}

heading() {
  printf '\n\033[1;36m%s\033[0m\n' "$1"
}

overview() {
  cat <<EOF
$BANNER
EOF
  heading "Start menu & shell"
  one neos-start "Windows-like start menu: apps, files, settings, power"
  one neos-menu "Terminal start menu (sections for code, internet, drivers...)"
  one neos-fetch "System info banner (neofetch-style ASCII logo)"
  one neos-help  "This command reference"

  heading "Packages & system"
  one neo        "Unified NeoOS CLI: NeoCore (system status/info/diagnose) + NeoPkg 2.0 + neos-*"
  one pkg        "Termux-style package manager over apt (install/search/upgrade; NeoPkg 2.0)"
  one neos-update "Plan-first system updater"
  one neos-where  "Find which package provides a command/file"
  one neos-drivers "Hardware driver installer (GPU, wifi, bluetooth, firmware)"
  one neos-uranium "One-tap driver install + online DB (suggest/scan/update)"
  one neos-mirror   "Switch apt sources to the NeoOS centralized mirror"
  one neos-ports  "List listening services + owning packages"
  one neos-backup "Back up configs + installed-package list"
  one neos-serve  "Quick HTTP file sharing server (with upload option)"

  heading "Monitor & health"
  one neos-monitor "Live system monitor (CPU, memory, top processes)"
  one neos-health  "System health check (connectivity, apt, disk...)"
  one neos-disk    "Disk usage analyzer"
  one neos-clean   "Free space by cleaning caches, logs, temp (dry-run first)"
  one neos-battery "Battery / power status"

  heading "Network"
  one neos-net   "Network diagnostics (interfaces, gateway, DNS, ping)"
  one neos-ip    "Local + public IP addresses"
  one neos-speedtest "Quick download/upload speed test"

  heading "Productivity"
  one neos-todo  "Simple todo list"
  one neos-notes "Quick plain-text notes"
  one neos-timer "Countdown / pomodoro timer"
  one neos-calc  "Calculator"
  one neos-fortune "Random quote or NeoOS tip"

  heading "Dev"
  one neos-new   "Scaffold new projects (bash, python, c, web, shlib)"
  one neos-lang  "Install / list language toolchains"
  one neos-launch "Enter or create a Project Capsule workspace (neos launch)"

  heading "Recovery & maintenance"
   one neos-doctor "NeoDoctor: automatic diagnostics & self-repair"
   one neos-doctor-ai "Doctor with AI diagnosis: neos-doctor --ai (uses neos-ai)"
  one neos-clean "Free disk by cleaning caches/logs/temp (neos clean)"
  one neos-fix   "Automatic repair: dpkg/apt --fix-broken + autoremove (neos fix)"
  one neos-ai    "On-device AI assistant (Qwen 2.5 0.5B local or HTTP backend)"

  heading "Users"
  one neos-users  "User manager: add (normal/Admin), delete, passwd, autologin"
  one neos-guest  "Disposable guest account: enable/disable/remove/status"

  heading "Install & distros"
  one neos-installer "Calamares graphical installer (write NeoOS to disk)"
  one neos-distro  "Install/run other distros as proot containers"

  heading "Graphics & Windows apps"
  one neos-gui     "Install + select a GUI session (Openbox / Sway / Xfce)"
  one neos-wayland "Start a Weston + XWayland Wayland session"
  one neos-xfce    "Start the NeoOS XFCE desktop session (dark, bottom panel)"
  one neos-wine    "Run Windows console (.exe) apps in a Win10 prefix"
  one neos-winetricks "Wine + Winetricks setup helper"
  one neos-winevm  "Isolated 'Wine VMs' for Windows applications"

  heading "Quick tools"
  one neos-brightness "Screen backlight control (status/up/down/set)"
  one neos-audio      "Mixer helper (status/up/down/mute)"
  one neos-mounts     "List mounted filesystems"
  one neos-inode      "Filesystem inode / disk usage"
  one neos-sensors    "Hardware temperatures + fan speeds"
  one neos-grep       "rg-or-grep search wrapper"
  one neos-diff       "Colored diff of two files"
  one neos-archive    "Tar wrapper (create/list/extract)"
  one neos-cipher     "AES-256 file encrypt/decrypt (openssl)"
  one neos-theme      "Toggle Arc light/dark + Papirus theme"

  heading "NeoLIBs"
  one neolibs  "Multi-version shared-library manager + native NeoAPI (libneo.so C ABI)"

  heading "NeoX architecture (system components)"
  one neos-core      "NeoCore: system API (status/info/services/diagnose)"
  one neos-libs     "NeoLIBs: native C-library API (libneo.so / NeoAPI)"
  one neos-pkg      "NeoPkg 2.0: unified package manager"
  one neos-security "NeoSecurity: SUID/writable audit & package verification"
  one neos-agent    "NeoAgent: system agent (controlled capabilities)"
  one neos-apps     "NeoApps: native application framework"
  one neos-store    "NeoStore: app/package store browser"
  one neos-shell    "NeoShell: list shells & launch default"
  one neos-desktop  "NeoDesktop: desktop session (xfce/wayland/gui)"
  one neos-wm       "NeoWM: Wayland window management"
  one neos-mobile   "NeoMobile: Termux/proot Android helpers"
  one neos-hw       "NeoHardware: CPU/memory/disks/PCI/USB detection"
  one neos-doctor   "NeoDoctor: auto diagnostics & self-repair"
  one neos-recovery "NeoRecovery: snapshot restore & rollback"
  one neos-snapshots "NeoSnapshots: NeoPkg transaction snapshots"
  one neos-sandbox  "NeoSandbox: command isolation (bwrap/firejail)"
  one neos-vm       "NeoVM: QEMU/KVM virtual machine management"
  one neos-dev      "NeoDev: developer toolchains & projects"
  one neos-code     "NeoCode: IDE launcher"
  one neos-files    "NeoFiles: file manager (ranger/list)"
  one neos-search   "NeoSearch: system-wide content search"
  one neos-notify   "NeoNotify: desktop notifications"
  one neos-logs     "NeoLogs: recent system logs"
  one neos-config   "NeoConfig: NeoOS configuration store"
  one neos-power    "NeoPower: power/battery profiling"
  one neos-perf     "NeoPerformance: resource profiling"
  one neos-access   "NeoAccessibility: reader/zoom/keyboard"
  one neos-locale   "NeoLocalization: locale & timezone"
  one neos-test     "NeoTest: component/system test suites"
  one neos-build    "NeoBuild: ISO/rootfs/proot build driver"
  one neos-sdk      "NeoSDK: NeoAPI SDK env & headers"
  one neos-repo     "NeoRepo: package repository sources"
  one neos-model    "NeoModel: local AI model management"

  printf '\n\033[2mRun "neos-help <command>" for full usage of one tool.\033[0m\n'
}

full_usage() {
  local cmd="$1" f
  for f in "$(dirname "$0")/$cmd" "$cmd"; do
    if [[ -f "$f" ]]; then
      echo "=== $cmd ==="
      awk 'NR>1 && /^#/ { sub(/^# ?/,""); if (length) print "  " $0; next } /^#/ { next } /^[^#]/ { exit }' "$f" | head -30
      return 0
    fi
  done
  echo "neos-help: no such command '$cmd'"
  return 1
}

summary_table() {
  local cmd
  printf '\033[1;36m%-18s\033[0m %s\n' 'COMMAND' 'SUMMARY'
  printf '%s\n' '------------------------------------------------------------'
  for cmd in \
    neos-menu neos-fetch neos-help \
    pkg neos-update neos-where neos-drivers neos-mirror neos-ports neos-backup neos-serve \
    neos-monitor neos-disk neos-clean neos-battery \
    neos-net neos-ip neos-speedtest \
    neos-todo neos-notes neos-timer neos-calc neos-fortune \
     neos-new neos-lang neos-health \
     neo neos-users neos-guest \
    neos-installer neos-distro \
    neos-wayland neos-wine neos-winetricks neos-winevm \
    neos-uranium neos-xfce neos-brightness neos-audio neos-mounts \
    neos-inode neos-sensors neos-grep neos-diff neos-archive neos-cipher neos-theme \
    neos-core neos-libs neos-pkg neos-security neos-agent neos-apps neos-store \
    neos-shell neos-desktop neos-wm neos-mobile neos-hw neos-doctor neos-recovery \
    neos-snapshots neos-sandbox neos-vm neos-dev neos-code neos-files neos-search \
    neos-notify neos-logs neos-config neos-power neos-perf neos-access neos-locale \
    neos-test neos-build neos-sdk neos-repo neos-model \
    neolibs; do
    if [[ -f "$(dirname "$0")/$cmd" ]] || command -v "$cmd" >/dev/null 2>&1; then
      summary=$(grep -m1 '^# [a-z].* —' "$(dirname "$0")/$cmd" 2>/dev/null | sed 's/^# //; s/ — /: /')
      printf '  %-16s %s\n' "$cmd" "$summary"
    fi
  done
}

list_only() {
  printf '%s\n' 'neos-menu neos-fetch neos-help pkg neos-update neos-where' \
    'neos-drivers neos-ports neos-backup neos-serve neos-monitor neos-disk' \
    'neos-clean neos-battery neos-net neos-ip neos-speedtest neos-todo' \
    'neos-notes neos-timer neos-calc neos-fortune neos-new neos-lang' \
    'neos-health neos-users neos-guest neos-installer neos-distro' \
    'neos-wayland neos-wine neos-winetricks neos-winevm neos-uranium neos-xfce neos-mirror' \
    'neos-brightness neos-audio neos-mounts neos-inode neos-sensors' \
     'neos-grep neos-diff neos-archive neos-cipher neos-theme neo neolibs' \
     'neos-core neos-libs neos-pkg neos-security neos-agent neos-apps neos-store' \
     'neos-shell neos-desktop neos-wm neos-mobile neos-hw neos-doctor neos-recovery' \
     'neos-snapshots neos-sandbox neos-vm neos-dev neos-code neos-files neos-search' \
     'neos-notify neos-logs neos-config neos-power neos-perf neos-access neos-locale' \
     'neos-test neos-build neos-sdk neos-repo neos-model'
}

case "${1:-}" in
  --list|-l)    list_only ;;
  --all|-a)     summary_table ;;
  --help|-h|"") overview ;;
  *)            full_usage "$1" ;;
esac
