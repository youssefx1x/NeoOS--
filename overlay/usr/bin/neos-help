  printf '%s\n' 'neos-menu neos-fetch neos-help pkg neos-update neos-where' \
    'neos-drivers neos-ports neos-backup neos-serve neos-monitor neos-disk' \
    'neos-clean neos-battery neos-alive neos-welcome neos-net neos-ip neos-speedtest neos-todo' \
    'neos-notes neos-timer neos-calc neos-fortune neos-new neos-lang' \
    'neos-health neos-users neos-guest neos-installer neos-distro' \
    'neos-wayland neos-wine neos-winetricks neos-winevm neos-uranium neos-xfce neos-mirror' \
    'neos-brightness neos-audio neos-mounts neos-inode neos-sensors' \
     'neos-grep neos-diff neos-archive neos-cipher neos-theme neo neolibs' \
     'neos-core neos-libs neos-pkg neos-security neos-agent neos-apps neos-store' \
     'neos-shell neos-desktop neos-wm neos-mobile neos-hw neos-doctor neos-recovery' \
     'neos-snapshots neos-sandbox neos-vm neos-dev neos-code neos-files neos-search' \
     'neos-notify neos-logs neos-config neos-power neos-perf neos-access neos-locale' \
     'neos-test neos-build neos-sdk neos-repo neos-model neos-tools' \
     'neos-cloud neos-ipc neos-event neos-plugins neos-plugin-security'
}

show_version() {
  local ver="1.2.0" codename="Stable" name="" osv="" osc="" core="" api=""
  # Authoritative source: NeoCore's library (libneocore.sh).
  if [[ -r /usr/lib/neos/libneocore.sh ]]; then
    core="$(grep -m1E '^NEOCORE_VERSION=' /usr/lib/neos/libneocore.sh 2>/dev/null | sed -E 's/.*"([^"]+)".*/\1/')" || true
    api="$(grep -m1E '^NEOAPI_VERSION=' /usr/lib/neos/libneocore.sh 2>/dev/null | sed -E 's/.*"([^"]+)".*/\1/')" || true
  fi
  core="${core:-$ver}"
  api="${api:-$core}"
  # /etc/os-release only overrides when this is genuinely a NeoOS install
  # (otherwise we'd report the host distro on a dev machine).
  if [[ -r /etc/os-release ]]; then
    while IFS='=' read -r k v; do
      v="${v//\"/}"
      case "$k" in
        NAME)            name="$v" ;;
        VERSION)         osv="$v" ;;
        VERSION_CODENAME) osc="$v" ;;
      esac
    done < /etc/os-release
  fi
  if [[ "$name" == *"NeoOS"* ]]; then
    ver="${osv:-$ver}"
    codename="${osc:-$codename}"
  fi
  printf 'NeoOS %s (%s)\n' "$ver" "$codename"
  printf 'NeoCore %s\n' "$core"
  printf 'NeoAPI  %s\n' "$api"
}

quickstart() {
  cat <<'EOF'
NeoOS 1.2.0 — getting started
============================

Install NeoPkg / update:    neos-update --apply        (apt update + upgrade + autoremove)
Install system packages:    apt install <pkg>          (or: neos system install <pkg>)
Install dev toolchains:     neos-lang install <python|node|rust|go|java|...>

Navigation & help:
    neos-help               this command reference
    neos-help --list        all commands, one per line
    neos-tools list         all NeoOS tools + summaries
    neos-start              NeoOS start menu (apps / files / settings / power)
    neos <cmd>              umbrella: doctor | clean | fix | launch | suggest
    neos alive|welcome|tip  liveliness pulse / welcome banner / tip of the day

System health:
    neos doctor             NeoPulse health narration + neos-health checks
    neos doctor --ai        same + AI explanation of any problem
    neos-doctor --fix       automated dpkg/apt repair
    neos-ai --check         verify the AI backend / model

Files & projects:
    neos launch <name>      create + enter a project Capsule workspace
    neos-files              file manager (ranger)
    neos-backup             back up configs + package list
    neos-serve              quick HTTP file sharing (with upload)

Networking:
    neos-net                interfaces, gateway, DNS, ping
    neos-ip                 local + public IP
    neos-speedtest          download/upload speed test
    neos-cloud              sync to Google Drive / WebDAV via rclone

Graphics:
    neos-wayland            install + start a Weston/XWayland session
    neos-gui                install + select a GUI session (openbox/sway/xfce)

Productivity:
    neos-todo               todo list     neos-notes   notes
    neos-timer              countdown     neos-calc    calculator
    neos-fortune            random quotes/tips

Tips:
    • Run `neos-help <command>` for the full usage of any tool.
    • Most tools accept `-h | --help` for a short usage line.
    • Need a command? Try `neos-tools menu` (whiptail) or `neos-start`.
EOF
}

search() {
  local term="${1:-}"
  [[ -n "$term" ]] || { echo "usage: neos-help --search <term>" >&2; return 2; }
  local dir="$(dirname "$0")" f base sum matched=0
  printf 'Commands matching "%s":\n' "$term"
  for f in "$dir"/neos-* "$dir"/neo "$dir"/pkg "$dir"/neolibs; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    sum="$(grep -m1 '^# [a-z].* — ' "$f" 2>/dev/null | sed 's/^# //; s/ — /: /' || true)"
    sum="${sum:-(no summary)}"
    if printf '%s %s' "$base" "$sum" | grep -qi -- "$term"; then
      printf '  %-16s %s\n' "$base" "$sum"
      matched=$((matched+1))
    fi
  done
  (( matched )) || echo "  (no matches — try: neos-help --list)"
}

case "${1:-}" in
  --list|-l)    list_only ;;
  --all|-a)     summary_table ;;
  version|--version|-V) show_version ;;
  quickstart)   quickstart ;;
  --search)     shift; search "${1:-}" ;;
  --help|-h|"") overview ;;
  *)            full_usage "$1" ;;
esac
