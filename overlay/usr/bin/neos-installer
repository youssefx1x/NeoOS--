#!/usr/bin/env bash
# neos-installer — launch the NeoOS graphical installer (Calamares).
#
#   neos-installer              launch the installer (downloads Calamares
#                               + the GUI stack on first run)
#   neos-installer --install    only install Calamares + GUI, don't launch
#   neos-installer --check      verify prerequisites and exit
#   neos-installer --no-gui     run calamares against an existing DISPLAY
#                               (don't start our own Wayland session)
#
# NeoOS is terminal-first, so an installer needs a GUI stack. We bring up
# a Weston + XWayland session on first launch, then run Calamares (Qt6,
# uses XWayland via xcb). You must be able to use a mouse/touchscreen on
# the running system.

set -euo pipefail

REPO_PKGS="/usr/lib/neos/packages.calamares"

log() { printf '\033[1;36m[neos-installer]\033[0m %s\n' "$*"; }
info(){ printf '\033[1;32m[neos-installer]\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m[neos-installer]\033[0m %s\n' "$*" >&2; }

run_root() {
  if [[ $EUID -eq 0 ]]; then "$@"
  elif command -v sudo >/dev/null 2>&1; then sudo "$@"
  else err "root required for: $*"; return 1; fi
}

# Determine the Calamares settings dir + branding we must provide.
CALAMARES_ETC="/etc/calamares"
mk_settings() {
  # Write a NeoOS-branded settings.conf into /etc/calamares so Calamares
  # uses our branding + a Debian-compatible install sequence. If the
  # calamares-settings-debian package already wrote /etc/calamares/settings.conf
  # we replace the `branding:` line and keep the rest (robust across
  # package config drift).
  local base="$CALAMARES_ETC/settings.conf"
  mkdir -p "$CALAMARES_ETC"
  if [[ -f "$base" ]] && grep -q '^branding:' "$base"; then
    log "Rebranding existing settings.conf to NeoOS"
    sed -i 's/^branding:.*/branding: neoos/' "$base"
  else
    log "Writing NeoOS settings.conf"
    cat > "$base" <<'EOF'
---
# "local" is LIBDIR/calamares/modules (multiarch on Debian).
modules-search: [ local, /usr/lib/calamares/modules ]
oem-setup: false
disable-cancel: false
disable-cancel-during-exec: false
quit-at-end: false

sequence:
- show:
  - welcome
  - locale
  - keyboard
  - partition
  - users
  - summary

- exec:
  - partition
  - mount
  - unpackfs
  - machineid
  - fstab
  - locale
  - keyboard
  - localecfg
  - users
  - displaymanager
  - networkcfg
  - hwclock
  - grubcfg
  - bootloader
  - packages
  - initramfscfg
  - initramfs
  - umount

- show:
  - finished

branding: neoos
prompt-install: false
dont-chroot: false
EOF
  fi
}

need_install() {
  # Returns 0 if calamares is NOT installed (i.e. we need to install).
  command -v calamares >/dev/null 2>&1 || return 0
  return 1
}

install_stack() {
  if ! need_install; then
    log "Calamares already installed."
    return 0
  fi
  log "Installing Calamares + GUI stack..."
  local pkgs=(
    calamares calamares-settings-debian rsync cryptsetup os-prober
    qml-module-qtquick-window2 qml-module-qtquick2 qml-module-qtquick-controls2
    qml-module-qtgraphicaleffects policykit-1 pkexec
    weston xwayland
  )
  run_root apt-get update
  run_root apt-get install -y "${pkgs[@]}"
  info "Installed Calamares."
}

ensure_display() {
  # Start a Wayland (Weston+XWayland) session if no DISPLAY/WAYLAND yet.
  if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
    return 0
  fi
  log "No display active; starting Weston + XWayland session..."
  ensure_display_session
  sleep 3
}

ensure_display_session() {
  local session_script="${XDG_CONFIG_HOME:-$HOME/.config}/neos/installer-session.sh"
  mkdir -p "$(dirname "$session_script")"
  cat > "$session_script" <<'EOF'
#!/usr/bin/env bash
# NeoOS installer GUI session: Weston + XWayland, then leave DISPLAY set.
# Uses DRM when a GPU is present (visible on the local screen), else a
# headless framebuffer (e.g. for capture or GPU-less boxes).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$HOME/.xdg}"
mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_SESSION_TYPE=wayland
if [ -e /dev/dri/card0 ] && [ -w /dev/dri/card0 ] 2>/dev/null; then
  weston --backend=drm --xwayland &
else
  weston --backend=headless --xwayland &
fi
sleep 2
export DISPLAY=:0
exec "$@"
EOF
  chmod +x "$session_script"
  bash "$session_script"
}

cmd_launch() {
  ensure_display
  mk_settings
  log "Starting NeoOS Installer (Calamares)..."
  # xhost access for root over XWayland, then elevate to calamares.
  if command -v xhost >/dev/null 2>&1; then
    xhost +si:localuser:root 2>/dev/null || true
  fi
  if [[ $EUID -eq 0 ]]; then
    calamares
  elif command -v pkexec >/dev/null 2>&1; then
    pkexec calamares
  else
    run_root calamares
  fi
}

case "${1:-launch}" in
  launch)
    install_stack
    cmd_launch
    ;;
  --install|install)
    install_stack
    ;;
  --check|check)
    if command -v calamares >/dev/null 2>&1; then
      echo "calamares: OK ($(command -v calamares))"
    else
      echo "calamares: NOT INSTALLED (run: neos-installer)"
    fi
    for c in weston xwayland; do
      command -v "$c" >/dev/null && echo "$c: OK" || echo "$c: MISSING"
    done
    echo "display: ${DISPLAY:-none}  wayland: ${WAYLAND_DISPLAY:-none}"
    ;;
  help|-h|--help)
    sed -n '2,14p' "$0" | sed 's/^#   /  /; s/^#//'
    ;;
  *)
    err "unknown command: $1"; sed -n '2,14p' "$0" | sed 's/^#   /  /; s/^#//'; exit 2 ;;
esac
