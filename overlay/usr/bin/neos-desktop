#!/usr/bin/env bash
# neos-desktop — NeoDesktop: launch NeoOS desktop session (xfce/wayland/gui)
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
resolve() { command -v "$1" 2>/dev/null || echo "$SELF_DIR/$1"; }

case "${1:-start}" in
  start|run) exec "$(resolve neos-xfce)" ;;
  wayland) exec "$(resolve neos-wayland)" ;;
  gui) exec "$(resolve neos-gui)" ;;
  *) echo "usage: neos-desktop [start|wayland|gui]" >&2; exit 2 ;;
esac
