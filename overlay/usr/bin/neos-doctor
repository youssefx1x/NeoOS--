#!/usr/bin/env bash
# neos-doctor — NeoDoctor: automatic system diagnostics & self-repair.
#   neos-doctor        run diagnostics (APT, dpkg, held packages, health)
#   neos-doctor --fix  attempt repair (apt-get --fix-broken, autoremove)
#   neos-doctor --ai   send the report to the on-device AI (neos-ai) for a
#                      plain-English explanation + one concrete fix
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
resolve() { command -v "$1" 2>/dev/null || printf '%s/%s' "$SELF_DIR" "$1"; }

fix=0; ai=0
for a in "$@"; do
  case "$a" in
    --fix) fix=1 ;;
    --ai)  ai=1 ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "neos-doctor: unknown option: $a" >&2; exit 2 ;;
  esac
done

run_report() {
  echo "=== neos-doctor ==="
  "$(resolve neos-health)" >/dev/null 2>&1 && echo "health: OK" || echo "health: review 'neos-health'"
  if command -v dpkg >/dev/null 2>&1; then
    held="$(dpkg --get-selections 2>/dev/null | awk '$2=="hold"{print $1}')"
    [[ -n "$held" ]] && echo "held packages: $held" || true
  fi
  if command -v apt-get >/dev/null 2>&1; then
    if apt-get --fix-broken --dry-run install >/dev/null 2>&1; then echo "dpkg: OK"
    else echo "dpkg: issues (run neos-doctor --fix as root)"; fi
  fi
  if [[ $fix -eq 1 ]] && command -v apt-get >/dev/null 2>&1; then
    echo "repairing..."
    apt-get --fix-broken install -y 2>/dev/null || echo "neos-doctor: repair needs root" >&2
  fi
  echo "=== end neos-doctor ==="
}

if [[ $ai -eq 1 ]]; then
  if command -v neos-ai >/dev/null 2>&1; then
    report="$(run_report)"
    printf '%s\n' "$report" | neos-ai \
      "You are NeoOS's diagnostician. Below is a system health report. Summarise any problem in plain English and give ONE concrete fix. Keep it short."
    printf '%s\n' "$report" | tail -1
  else
    echo "neos-doctor: --ai requested but neos-ai is not installed." >&2
    run_report
  fi
else
  run_report
fi
