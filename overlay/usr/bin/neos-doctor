#!/usr/bin/env bash
# neos-doctor — NeoDoctor: automatic system diagnostics & self-repair
set -euo pipefail
fix=0; [[ "${1:-}" == "--fix" ]] && fix=1
echo "=== neos-doctor ==="
neos-health >/dev/null 2>&1 && echo "health: OK" || echo "health: review 'neos-health'"
if command -v dpkg >/dev/null 2>&1; then
  held="$(dpkg --get-selections 2>/dev/null | awk '$2=="hold"{print $1}')"
  [[ -n "$held" ]] && echo "held packages: $held" || true
fi
if command -v apt-get >/dev/null 2>&1; then
  if apt-get --fix-broken --dry-run install >/dev/null 2>&1; then echo "dpkg: OK"
  else echo "dpkg: issues (run neos-doctor --fix as root)"; fi
fi
if [[ $fix -eq 1 ]] && command -v apt-get >/dev/null 2>&1; then
  echo "repairing..."
  apt-get --fix-broken install -y 2>/dev/null || echo "neos-doctor: repair needs root" >&2
fi
echo "=== end neos-doctor ==="
