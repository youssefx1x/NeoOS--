#!/usr/bin/env bash
# neos-cloud — NeoCloud: sync files, settings & backups (Google Drive, WebDAV) via rclone.
#   neos-cloud status              show rclone version + configured remotes
#   neos-cloud list                list configured remotes (alias: remotes)
#   neos-cloud sync <remote> [path]  mirror a local path to the remote (rclone sync)
#   neos-cloud pull <remote> [path]  mirror a remote path to local
#   neos-cloud backup [remote]     snapshot configs (neos-backup) then sync to remote
#   neos-cloud remote              run `rclone config` to add/configure a remote
#   neos-cloud --version           print version
#   neos-cloud --help              show this usage
set -euo pipefail

NEOS_VERSION="${NEOS_VERSION:-1.2.0}"

log() { printf '\033[1;36m[neos-cloud]\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m[neos-cloud]\033[0m %s\n' "$*" >&2; }

require_rclone() {
  if ! command -v rclone >/dev/null 2>&1; then
    err "rclone not installed (apt install rclone)"
    return 1
  fi
}

run_root() {
  if [[ $EUID -eq 0 ]]; then "$@"; return $?
  elif command -v sudo >/dev/null 2>&1; then sudo "$@"; return $?
  else err "root required for: $*"; return 1; fi
}

usage() {
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
}

cmd_status() {
  require_rclone || return 1
  log "NeoCloud:"
  rclone version | head -n1
  rclone listremotes 2>/dev/null || echo "  (no remotes configured — run: neos-cloud remote)"
}

cmd_list() {
  require_rclone || return 1
  rclone listremotes
}

cmd_sync() {
  require_rclone || return 1
  local remote="${1:-}" path="${2:-.}"
  [[ -n "$remote" ]] || { err "usage: neos-cloud sync <remote> [path]"; return 2; }
  log "syncing $path -> $remote:"
  run_root rclone sync "$path" "${remote}:" || { err "sync failed"; return 1; }
}

cmd_pull() {
  require_rclone || return 1
  local remote="${1:-}" dest="${2:-$HOME}"
  [[ -n "$remote" ]] || { err "usage: neos-cloud pull <remote> [path]"; return 2; }
  log "pulling $remote: -> $dest"
  run_root rclone sync "${remote}:" "$dest" || { err "pull failed"; return 1; }
}

cmd_backup() {
  require_rclone || return 1
  local remote="${1:-}"
  [[ -n "$remote" ]] || { err "usage: neos-cloud backup <remote>"; return 2; }
  log "creating local snapshot (neos-backup)..."
  neos-backup >/dev/null 2>&1 || err "neos-backup unavailable — syncing $HOME only"
  log "syncing $HOME -> $remote:neos-backups/"
  run_root rclone sync "$HOME" "${remote}:neos-backups/" || { err "backup sync failed"; return 1; }
}

case "${1:-status}" in
  status)        cmd_status ;;
  list|remotes)  cmd_list ;;
  sync)          shift; cmd_sync "$@" ;;
  pull)          shift; cmd_pull "$@" ;;
  backup)        shift; cmd_backup "$@" ;;
  remote|config) rclone config ;;
  --version)     echo "neos-cloud ${NEOS_VERSION}" ;;
  -h|--help|help) usage ;;
  *) err "unknown command '${1:-}' (try: neos-cloud --help)"; exit 2 ;;
esac
