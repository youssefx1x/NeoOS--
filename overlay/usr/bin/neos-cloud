#!/usr/bin/env bash
# neos-cloud — NeoCloud: Google Drive cloud storage for NeoOS.
# Connects your Google account from the terminal (rclone device-code OAuth)
# and syncs files/backups to your free 15 GB of Google Drive storage.
#
#   neos-cloud                      show status (linked account + quota)
#   neos-cloud login                link your Google account (terminal OAuth)
#   neos-cloud logout               unlink the account and forget tokens
#   neos-cloud status               show linked account + used/free space
#   neos-cloud list [path]          list files on Drive (root if omitted)
#   neos-cloud upload <local> [dir] copy a file/folder up to Drive
#   neos-cloud download <remote> [local-dir]   copy a file/folder down
#   neos-cloud sync <local> [dir]   one-way sync a local folder to Drive
#   neos-cloud backup               run neos-backup, then upload the archive
#   neos-cloud quota                show used/free space on Drive
#   neos-cloud test                 verify the link works
#
# Uses rclone's Google Drive backend. The OAuth handshake happens in the
# terminal: rclone prints a URL you open in any browser, then you paste the
# code back. No client secrets are embedded — rclone uses its public client.

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
resolve() { command -v "$1" 2>/dev/null || echo "$SELF_DIR/$1"; }

REMOTE="${NEOS_CLOUD_REMOTE:-gdrive}"

log()  { printf '\033[1;36m[neos-cloud]\033[0m %s\n' "$*"; }
info() { printf '\033[1;32m[neos-cloud]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[neos-cloud]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[neos-cloud]\033[0m %s\n' "$*" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

usage() { sed -n '2,21p' "$0" | sed 's/^#   /  /; s/^#//'; }

# ensure_rclone — install rclone if missing.
ensure_rclone() {
  if have rclone; then return 0; fi
  warn "rclone is required for Google Drive but not installed."
  if command -v apt-get >/dev/null 2>&1; then
    if [[ $EUID -eq 0 ]]; then
      DEBIAN_FRONTEND=noninteractive apt-get install -y rclone >/dev/null 2>&1 \
        || { err "could not install rclone (apt-get install rclone)"; return 1; }
    elif have sudo; then
      sudo apt-get install -y rclone >/dev/null 2>&1 \
        || { err "could not install rclone (sudo apt-get install rclone)"; return 1; }
    else
      err "install rclone manually: apt-get install rclone"
      return 1
    fi
  else
    err "install rclone manually: https://rclone.org/install/"
    return 1
  fi
  have rclone || { err "rclone install finished but binary not on PATH"; return 1; }
}

# linked — does the gdrive remote exist AND carry an OAuth token?
linked() {
  rclone listremotes 2>/dev/null | grep -qx "$REMOTE:" && \
    rclone config show "$REMOTE" 2>/dev/null | grep -q '^token'
}

# show_quota — prints used/total (the free 15 GB tier shows 15 GiB total).
show_quota() {
  local out
  out=$(rclone about "$REMOTE:" 2>/dev/null) || { err "cannot read Drive quota (is the link valid?)"; return 1; }
  printf '%s\n' "$out" | sed 's/^/  /'
  local total used free
  total=$(printf '%s\n' "$out" | awk -F': ' '/^Total/{print $2; exit}')
  used=$(printf '%s\n' "$out" | awk -F': ' '/^Used/{print $2; exit}')
  free=$(printf '%s\n' "$out" | awk -F': ' '/^Free/{print $2; exit}')
  if [[ -n "$total" && -n "$used" ]]; then
    log "Google Drive: $used used of $total (free tier = 15 GB), $free available."
  fi
}

do_login() {
  ensure_rclone || return 1
  if linked; then
    warn "remote '$REMOTE' is already linked."
    info "run 'neos-cloud logout' first to re-authenticate as a different account."
    return 0
  fi
  echo
  log "Linking your Google account to '$REMOTE' (terminal OAuth)."
  echo
  echo "  Next, rclone will ask a few questions — press Enter to accept the"
  echo "  defaults for client_id / scope, and choose 'No' for the web browser"
  echo "  prompt. It will then print a URL:"
  echo
  echo "    1. Open the URL in any browser (phone/PC) and sign in to Google."
  echo "    2. Grant access to your Drive (free 15 GB)."
  echo "    3. Copy the verification code and paste it back into this terminal."
  echo
  # Headless device flow: never try to open a browser on this machine.
  rclone config create "$REMOTE" drive config_is_local=false
  echo
  if linked; then
    info "Linked '$REMOTE' to your Google account."
    log "Drive quota:"
    show_quota || true
    log "Try: neos-cloud list"
  else
    # rclone may have created a stub remote with no token if the OAuth
    # handshake was cancelled. Remove it so the next login starts clean.
    rclone listremotes 2>/dev/null | grep -qx "$REMOTE:" && rclone config delete "$REMOTE" 2>/dev/null || true
    err "link did not complete — re-run 'neos-cloud login' and paste the code."
    return 1
  fi
}

do_logout() {
  ensure_rclone || return 1
  if ! linked; then
    warn "remote '$REMOTE' is not linked."
    return 0
  fi
  if [[ -n "${NEOS_CLOUD_FORCE:-}" ]]; then
    rclone config delete "$REMOTE"
    info "Removed remote '$REMOTE'."
    return 0
  fi
  read -r -p "Remove Google Drive link '$REMOTE'? [y/N] " a
  if [[ "$a" =~ ^[Yy]$ ]]; then
    rclone config delete "$REMOTE"
    info "Removed remote '$REMOTE'."
  else
    info "aborted."
  fi
}

do_status() {
  ensure_rclone || return 1
  log "NeoCloud — Google Drive"
  if ! linked; then
    warn "No Google account linked yet."
    echo "  run: neos-cloud login"
    return 0
  fi
  info "Linked remote: $REMOTE"
  echo "  rclone: $(rclone version 2>/dev/null | head -1)"
  echo "  Drive quota:"
  show_quota || true
}

do_list() {
  local path="${1:-}"
  ensure_rclone || return 1
  linked || { err "not linked — run 'neos-cloud login' first"; return 1; }
  log "Listing '$REMOTE:${path:-/}'"
  rclone ls "$REMOTE:$path" 2>&1 || { err "cannot list '$REMOTE:$path'"; return 1; }
}

do_upload() {
  local localpath="${1:-}" dstdir="${2:-}"
  [[ -n "$localpath" ]] || { err "usage: neos-cloud upload <local> [dir]"; return 2; }
  [[ -e "$localpath" ]] || { err "no such file/dir: $localpath"; return 1; }
  ensure_rclone || return 1
  linked || { err "not linked — run 'neos-cloud login' first"; return 1; }
  log "Uploading '$localpath' -> $REMOTE:${dstdir:-/}"
  rclone copy "$localpath" "$REMOTE:$dstdir" 2>&1 || { err "upload failed"; return 1; }
  info "Upload complete."
}

do_download() {
  local remotepath="${1:-}" localdir="${2:-.}"
  [[ -n "$remotepath" ]] || { err "usage: neos-cloud download <remote> [local-dir]"; return 2; }
  ensure_rclone || return 1
  linked || { err "not linked — run 'neos-cloud login' first"; return 1; }
  log "Downloading '$REMOTE:$remotepath' -> $localdir"
  rclone copy "$REMOTE:$remotepath" "$localdir" 2>&1 || { err "download failed"; return 1; }
  info "Download complete."
}

do_sync() {
  local localpath="${1:-}" dstdir="${2:-}"
  [[ -n "$localpath" ]] || { err "usage: neos-cloud sync <local> [dir]"; return 2; }
  [[ -d "$localpath" ]] || { err "sync expects a directory: $localpath"; return 1; }
  ensure_rclone || return 1
  linked || { err "not linked — run 'neos-cloud login' first"; return 1; }
  log "One-way sync '$localpath' -> $REMOTE:${dstdir:-/} (mirror)"
  rclone sync "$localpath" "$REMOTE:$dstdir" 2>&1 || { err "sync failed"; return 1; }
  info "Sync complete."
}

do_backup() {
  ensure_rclone || return 1
  linked || { err "not linked — run 'neos-cloud login' first"; return 1; }
  "$(resolve neos-backup)" 2>&1 | tail -1
  local latest
  latest="$(ls -1t "$HOME"/neos-backup-*.tar.gz 2>/dev/null | head -1 || true)"
  [[ -n "$latest" ]] || { err "neos-backup produced no archive"; return 1; }
  log "Uploading backup archive '$latest' to $REMOTE:backups/"
  rclone copy "$latest" "$REMOTE:backups/" 2>&1 || { err "backup upload failed"; return 1; }
  info "Backup uploaded to Drive: $REMOTE:backups/$(basename "$latest")"
}

do_test() {
  ensure_rclone || return 1
  if ! linked; then
    err "not linked — run 'neos-cloud login' first"
    return 1
  fi
  local out
  out=$(rclone lsd "$REMOTE:" 2>&1) && info "Link OK ($REMOTE)" || { err "link test failed: $out"; return 1; }
  echo "  top-level folders:"
  printf '%s\n' "$out" | sed 's/^/    /' | head -10
}

case "${1:-}" in
  login|link|connect|setup) shift || true; do_login ;;
  logout|unlink)            shift || true; do_logout ;;
  status)                   shift || true; do_status ;;
  quota|about)              ensure_rclone || exit 1; linked || { err "not linked — run 'neos-cloud login' first"; exit 1; }; show_quota ;;
  list|ls)                  shift || true; do_list "${1:-}" ;;
  upload|up|copy)           shift || true; do_upload "${1:-}" "${2:-}" ;;
  download|down|dl)         shift || true; do_download "${1:-}" "${2:-}" ;;
  sync)                     shift || true; do_sync "${1:-}" "${2:-}" ;;
  backup)                   shift || true; do_backup ;;
  test|check)               shift || true; do_test ;;
  -h|--help|help)           usage; exit 0 ;;
  *) err "unknown command: ${1:-}"; echo; usage; exit 2 ;;
esac
