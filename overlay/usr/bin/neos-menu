#!/usr/bin/env bash
# neos-menu — NeoOS terminal start menu
# Categories: Code applications (updated), Internet, Drivers, Wayland, System.

set -euo pipefail

case "${1:-}" in
  -h|--help|help)
    sed -n '2,3p' "$0" | sed 's/^# //; s/^#//'
    echo "  neos-menu            open the interactive start menu (whiptail/dialog)"
    echo "  neos-menu --help     this help"
    exit 0
    ;;
esac

# Whiptail is lighter than dialog; fall back to dialog if needed.
if command -v whiptail >/dev/null 2>&1; then
  MENU="whiptail"
elif command -v dialog >/dev/null 2>&1; then
  MENU="dialog"
else
  echo "neos-menu requires whiptail or dialog. Install one of: apt install whiptail dialog"
  exit 1
fi

BOX() {
  local title="$1" prompt="$2" height="$3" width="$4" listname="$5"
  shift 5
  if [[ "$MENU" == "dialog" ]]; then
    dialog --title "$title" --menu "$prompt" "$height" "$width" "$listname" "$@"
  else
    whiptail --title "$title" --menu "$prompt" "$height" "$width" "$listname" "$@"
  fi
}

run_as_root() {
  if [[ $EUID -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
     echo "root required: $*"
    return 1
  fi
}

# safe_tokens <name> — read a line, split into array SAFETOKENS, rejecting
# shell metacharacters so menu-driven commands can't be injected. Each token
# must match a conservative whitelist. Usage:
#   read -r -p "pkg command: " a; safe_tokens "pkg" <<<"$a" && pkg "${SAFETOKENS[@]}"
SAFETOKENS=()
err_msg() { printf '\033[1;31m[neos-menu]\033[0m %s\n' "$*" >&2; }

safe_tokens() {
  local label="$1" line t
  read -r line
  SAFETOKENS=()
  if [[ -z "$line" ]]; then
    err_msg "empty input"
    return 1
  fi
  # Split into tokens on whitespace only; no globbing, no field splitting of
  # the results, and crucially no eval, so values are never executed.
  IFS=$' \t' read -r -a SAFETOKENS <<< "$line"
  # Validate each token against a conservative whitelist of characters that
  # are valid in package/script names (alphanumerics plus common flags and
  # separators). Anything else is rejected rather than passed downstream.
  for t in "${SAFETOKENS[@]}"; do
    if ! printf '%s' "$t" | grep -qE '^[A-Za-z0-9_./+:@~=-]+$'; then
      err_msg "invalid token in $label: '$t'"
      return 1
    fi
  done
  return 0
}

main_menu() {
  local choice
  choice=$(BOX "NeoOS" "Select a section (arrows/enter, Tab to switch)" 24 72 14 \
    "Code"      "Updated code applications (compilers, editors, toolchains)" \
    "Internet"  "Browsers, messaging, network utilities" \
    "Drivers"   "Hardware / driver installer" \
    "Wayland"   "Wayland session and graphics stack" \
    "Wine"      "Windows apps: neos-wine + neos-winevm (Win10 VM)" \
    "NeoLIBs"   "Multi-version library manager" \
    "Monitor"   "Live system monitor, disk usage, cleaner, battery" \
    "Network"   "Diagnostics, IP info, speed test" \
    "Productivity" "Todos, notes, timer, calculator, fortune" \
    "Dev"       "Project scaffolds + language toolchains" \
    "Apps"      "NeoApps: install/run/search native apps" \
    "Tools"     "pkg manager, distro installer, backup, fetch, ports" \
    "System"    "System update, packages, shell, power" \
    "Quit"      "Exit to shell" 3>&1 1>&2 2>&3)
  case "$choice" in
    Code)     code_menu;;
    Internet) internet_menu;;
    Drivers)  run_as_root neos-drivers || { pause; main_menu; };;
    Wayland)  wayland_menu;;
    Wine)     wine_menu;;
    NeoLIBs)  neolibs_menu;;
    Monitor)  monitor_menu;;
    Network)  network_menu;;
    Productivity) productivity_menu;;
    Dev)      dev_menu;;
    Apps)     apps_menu;;
    Tools)    tools_menu;;
    System)   system_menu;;
    Quit|"")  return 0;;
  esac
  main_menu
}

code_menu() {
  local choice
  choice=$(BOX "NeoOS - Code" "Choose a code application" 22 70 12 \
    "Install toolchain" "build-essential, gcc, g++, make, cmake, git" \
    "Install editors"   "vim, neovim, emacs-nox, micro" \
    "Install languages" "python3-dev, nodejs, rustc, golang, openjdk" \
    "Install debuggers" "gdb, valgrind, strace, ltrace" \
    "Update code apps"  "apt update && apt upgrade (code applications)" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Install toolchain") run_as_root apt install -y build-essential gcc g++ make cmake ninja-build git || pause;;
    "Install editors")   run_as_root apt install -y vim neovim emacs-nox micro || pause;;
    "Install languages") run_as_root apt install -y python3-dev python3-pip nodejs npm rustc cargo golang default-jdk-headless || pause;;
    "Install debuggers") run_as_root apt install -y gdb valgrind strace ltrace || pause;;
    "Update code apps")  run_as_root apt update && run_as_root apt upgrade -y || pause;;
    *) return 0;;
  esac
  pause
}

internet_menu() {
  local choice
  choice=$(BOX "NeoOS - Internet" "Choose an internet application" 22 70 12 \
    "Install browsers"  "lynx, w3m, links terminal browsers" \
    "Install tools"     "curl, wget, aria2, openssh-client, rsync" \
    "Install network"   "nmap, dnsutils, whois, netcat, traceroute" \
    "Install messaging" "weechat, irssi terminal IRC" \
    "Configure network" "ip, ping, ethtool, network setup" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Install browsers") run_as_root apt install -y lynx w3m links elinks || pause;;
    "Install tools")    run_as_root apt install -y curl wget aria2 openssh-client rsync || pause;;
    "Install network")  run_as_root apt install -y nmap dnsutils whois netcat-openbsd traceroute || pause;;
    "Install messaging")run_as_root apt install -y weechat irssi || pause;;
    "Configure network") run_as_root sh -c 'dhclient -v; ip addr; ip route' 2>/dev/null || true; pause;;
    *) return 0;;
  esac
  pause
}

wayland_menu() {
  local choice
  choice=$(BOX "NeoOS - Wayland" "Wayland graphics stack" 22 70 12 \
    "Start Wayland"    "Launch Weston compositor with xwayland" \
    "Install Wayland"  "wayland, weston, wlroots (libwlroots), seatd" \
    "Install Winetricks" "Wine + winetricks (Windows app installer)" \
    "Wayland apps"     "foot, wmenu terminal + launcher" \
    "Drivers for GPU"  "mesa drivers, firmware (neos-drivers)" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Start Wayland")   neos-wayland;;
    "Install Wayland") run_as_root apt install -y wayland weston libwlroots-0.18 seatd xwayland foot wmenu || pause;;
    "Install Winetricks") neos-wine --install 2>&1 || true;;
    "Wayland apps")    run_as_root apt install -y foot wmenu || pause;;
    "Drivers for GPU") run_as_root neos-drivers || pause;;
    *) return 0;;
  esac
  pause
}

neolibs_menu() {
  local choice
  choice=$(BOX "NeoOS - NeoLIBs" "Multi-version library manager" 22 70 12 \
    "List libraries"  "neolibs list" \
    "Use a version"   "neolibs use <name>@<version>" \
    "Install version" "neolibs install <name>@<version>" \
    "Help"            "neolibs --help" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "List libraries")  neolibs list; pause;;
    "Use a version")   read -r -p "name@version (e.g. zlib@1.3.1): " spec; neolibs use "$spec" 2>&1 || true; pause;;
    "Install version") read -r -p "name@version (e.g. zlib@1.3.1): " spec; neolibs install "$spec" 2>&1 || true; pause;;
    "Help")            neolibs --help; pause;;
    *) return 0;;
  esac
}

wine_menu() {
  local choice
  choice=$(BOX "NeoOS - Wine" "Windows apps via Wine (Windows 10)" 22 72 12 \
    "Install Wine"   "wine + winetricks stack" \
    "Run an .exe"    "neos-wine <app.exe> (terminal/console apps)" \
    "Wine setup"     "Winetricks GUI (prefix config, components)" \
    "List Wine apps" "list installed .exe in the default prefix" \
    "VM: create"     "neos-winevm create <name> (isolated Win10 VM)" \
    "VM: list"       "neos-winevm list" \
    "VM: run app"    "neos-winevm run <name> -- <app.exe>" \
    "VM: install app" "neos-winevm install <name> <setup.exe>" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Install Wine")     neos-wine --install 2>&1 || true;;
    "Run an .exe")      read -r -p ".exe path: " exe; neos-wine "$exe" 2>&1 || true; pause;;
    "Wine setup")       neos-wine --setup 2>&1 || true;;
    "List Wine apps")   neos-wine --list-apps 2>&1 || true; pause;;
    "VM: create")       read -r -p "VM name (e.g. mywin10): " vmn; neos-winevm create "$vmn" 2>&1 || true; pause;;
    "VM: list")         neos-winevm list 2>&1 || true; pause;;
    "VM: run app")      read -r -p "VM name: " vmn; read -r -p ".exe path: " exe; neos-winevm run "$vmn" -- "$exe" 2>&1 || true; pause;;
    "VM: install app")  read -r -p "VM name: " vmn; read -r -p "setup.exe path: " exe; neos-winevm install "$vmn" "$exe" 2>&1 || true; pause;;
    *) return 0;;
  esac
}

monitor_menu() {
  local choice
  choice=$(BOX "NeoOS - Monitor" "System health & disk" 20 70 7 \
    "Live monitor"   "neos-monitor (CPU, memory, top processes)" \
    "Health check"   "neos-health — verify the whole system" \
    "Disk usage"     "neos-disk top (largest directories)" \
    "Clean system"   "neos-clean (cache/log/temp cleaner, dry-run first)" \
    "Battery"        "neos-battery status" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Live monitor") neos-monitor 2>&1 || true; pause;;
    "Health check") neos-health 2>&1 || true; pause;;
    "Disk usage")   neos-disk top 2>&1 || true; pause;;
    "Clean system") neos-clean 2>&1 || true; pause;;
    "Battery")      neos-battery 2>&1 || true; pause;;
    *) return 0;;
  esac
}

network_menu() {
  local choice
  choice=$(BOX "NeoOS - Network" "Network diagnostics" 18 70 8 \
    "Diagnostics"   "neos-net (interfaces, gateway, DNS, connectivity)" \
    "My IP"         "neos-ip (local + public IPs)" \
    "Speed test"    "neos-speedtest" \
    "Ping"          "neos-net ping" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Diagnostics")  neos-net 2>&1 || true; pause;;
    "My IP")        neos-ip 2>&1 || true; pause;;
    "Speed test")   neos-speedtest 2>&1 || true; pause;;
    "Ping")         neos-net ping 2>&1 || true; pause;;
    *) return 0;;
  esac
}

productivity_menu() {
  local choice
  choice=$(BOX "NeoOS - Productivity" "Todos, notes, timers, calculator" 18 70 8 \
    "Todo list"    "neos-todo (add/done/list)" \
    "Notes"        "neos-notes (list/new/show)" \
    "Timer"        "neos-timer countdown/pomodoro" \
    "Calculator"   "neos-calc" \
    "Fortune"      "neos-fortune (random quote or tip)" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Todo list")   neos-todo 2>&1 || true; pause;;
    "Notes")       neos-notes 2>&1 || true; pause;;
    "Timer")       read -r -p "duration (e.g. 5m, 25m, pomodoro): " t; neos-timer "${t:-5m}" 2>&1 || true; pause;;
    "Calculator")  neos-calc 2>&1 || true; pause;;
    "Fortune")     neos-fortune 2>&1 || true; pause;;
    *) return 0;;
  esac
}

dev_menu() {
  local choice
  choice=$(BOX "NeoOS - Dev" "Scaffold projects + language toolchains" 18 70 8 \
    "New project"   "neos-new (bash, python, c, web, shlib)" \
    "Languages"     "neos-lang list (installed toolchains)" \
    "Install lang"  "neos-lang install (python, node, rust...)" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "New project")  read -r -p "template + name (e.g. bash mytool): " a; safe_tokens neos-new <<<"$a" && neos-new "${SAFETOKENS[@]}" 2>&1 || true; pause;;
    "Languages")    neos-lang list 2>&1 || true; pause;;
    "Install lang") read -r -p "language (python|node|rust|go|java|ruby|php): " l; neos-lang install "$l" 2>&1 || true; pause;;
    *) return 0;;
  esac
}

apps_menu() {
  local choice
  choice=$(BOX "NeoOS - Apps" "NeoApps native application framework" 20 70 6 \
    "List apps"    "neos-apps list — show installed apps" \
    "Run an app"   "neos-apps run <app> [args]" \
    "Search apps"  "neos-apps search <keyword>" \
    "Install app"  "neos-apps install <name>" \
    "Uninstall"    "neos-apps uninstall <app> (removes dir)" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "List apps")
      neos-apps list 2>&1 || true; pause;;
    "Run an app")
      read -r -p "app name (e.g. hello): " a
      neos-apps run "$a" 2>&1 || true; pause;;
    "Search apps")
      read -r -p "keyword: " a
      neos-apps search "$a" 2>&1 || true; pause;;
    "Install app")
      read -r -p "app name (or name + src): " a; safe_tokens neos-apps <<<"$a"
      neos-apps install "${SAFETOKENS[@]}" 2>&1 || true; pause;;
    "Uninstall")
      read -r -p "app name: " a
      neos-apps uninstall "$a" 2>&1 || true; pause;;
    *) return 0;;
  esac
}

tools_menu() {
  local choice
  choice=$(BOX "NeoOS - Tools" "NeoOS utility toolkit" 23 72 13 \
    "neos-help"    "List all NeoOS commands (command reference)" \
    "pkg manager"  "pkg update/upgrade/install/search (Termux-style)" \
    "pkg self-update" "Update NeoOS's own tools/scripts" \
    "neos-update"  "Plan-first system updater" \
    "neos-distro"  "Install other distros as proot containers" \
    "neos-backup"  "Back up configs + installed packages" \
    "neos-fetch"   "System info banner" \
    "neos-ports"   "List listening services and owning packages" \
    "neos-where"   "Find which package provides a command/file" \
    "neos-serve"   "Quick HTTP file sharing server" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "neos-help")     neos-help 2>&1 || true; pause;;
    "pkg manager")   read -r -p "pkg command (e.g. update|install vim): " a; safe_tokens pkg <<<"$a" && pkg "${SAFETOKENS[@]}" 2>&1 || true; pause;;
    "pkg self-update") pkg self-update 2>&1 || true; pause;;
    "neos-update")   neos-update 2>&1 || true; pause;;
    "neos-distro")   read -r -p "neos-distro command (e.g. list|available|install debian): " a; safe_tokens neos-distro <<<"$a" && neos-distro "${SAFETOKENS[@]}" 2>&1 || true; pause;;
    "neos-backup")   neos-backup 2>&1 || true; pause;;
    "neos-fetch")    neos-fetch; pause;;
    "neos-ports")    neos-ports 2>&1 || true; pause;;
    "neos-where")    read -r -p "command or file (e.g. vim): " a; neos-where "$a" 2>&1 || true; pause;;
    "neos-serve")    read -r -p "directory to share (default .): " d; neos-serve "${d:-.}" 2>&1 || true;;
    *) return 0;;
  esac
}

users_menu() {
  local choice name
  choice=$(BOX "NeoOS - Users" "Account management (root required)" 20 70 9 \
     "List users"        "neos-users list" \
     "Add user"          "Create a normal or admin user" \
     "Add admin user"    "Create a user with sudo (Administrator)" \
     "Delete user"       "Delete a user and home" \
     "Change password"   "neos-users passwd <name>" \
     "Guest account"     "Enable/disable/remove guest + autologin" \
     "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "List users")       run_as_root neos-users list 2>&1 || true;;
    "Add user")         read -r -p "username: " name && run_as_root neos-users add "$name" 2>&1 || true;;
    "Add admin user")   read -r -p "username: " name && run_as_root neos-users add "$name" --admin 2>&1 || true;;
    "Delete user")      read -r -p "username: " name && run_as_root neos-users delete "$name" 2>&1 || true;;
    "Change password")  read -r -p "username: " name && run_as_root neos-users passwd "$name" 2>&1 || true;;
    "Guest account")    guest_menu;;
    *) return 0;;
  esac
  pause
  users_menu
}

guest_menu() {
  local choice
  choice=$(BOX "NeoOS - Guest" "Disposable guest + first-time autologin" 16 70 6 \
     "Guest status"     "Show guest account + autologin state" \
     "Enable guest"     "Create guest account + auto-login on tty1" \
     "Disable autologin" "Keep guest account, stop auto-login" \
     "Remove guest"     "Delete guest account + reset script" \
     "Back" "Return to Users menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Guest status")     run_as_root neos-users guest status 2>&1 || true;;
    "Enable guest")     run_as_root neos-users guest enable 2>&1 || true;;
    "Disable autologin")run_as_root neos-users guest disable 2>&1 || true;;
    "Remove guest")     run_as_root neos-users guest remove 2>&1 || true;;
    *) return 0;;
  esac
  pause
  guest_menu
}

system_menu() {
  local choice
  choice=$(BOX "NeoOS - System" "System administration" 22 70 12 \
    "Update system"   "apt update && apt upgrade" \
    "Install packages" "apt install (prompt for name)" \
    "Remove packages" "apt remove (prompt for name)" \
    "Install to disk" "Graphical Calamares installer (neos-installer)" \
    "Users" "Manage users: create normal/Admin, guest account, autologin" \
    "Interactive shell" "Start a bash subshell (type exit to return)" \
    "Edit sources"    "nano /etc/apt/sources.list" \
    "Shutdown"        "Power off the machine" \
    "Reboot"          "Restart the machine" \
    "Back" "Return to main menu" 3>&1 1>&2 2>&3)
  case "$choice" in
    "Update system")    run_as_root apt update && run_as_root apt upgrade -y || pause;;
    "Install packages") read -r -p "packages: " pkgs; safe_tokens "package list" <<<"$pkgs" && run_as_root apt install -y "${SAFETOKENS[@]}" 2>&1 || true; pause;;
    "Remove packages")  read -r -p "packages: " pkgs; safe_tokens "package list" <<<"$pkgs" && run_as_root apt remove -y "${SAFETOKENS[@]}" 2>&1 || true; pause;;
    "Install to disk")  neos-installer 2>&1 || pause;;
    "Users")            users_menu;;
    "Interactive shell") bash;;
    "Edit sources")     run_as_root nano /etc/apt/sources.list 2>&1 || true;;
    "Shutdown")         run_as_root shutdown -h now 2>&1 || true; return 0;;
    "Reboot")           run_as_root reboot 2>&1 || true; return 0;;
    *) return 0;;
  esac
  pause
}

pause() {
  read -r -p "Press Enter to continue..."
}

main_menu
