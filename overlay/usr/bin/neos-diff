#!/usr/bin/env bash
# neos-diff — colored diff of two files
set -euo pipefail
NEOS_VERSION="${NEOS_VERSION:-1.2.0}"
case "${1:-}" in
  -h|--help) echo "usage: neos-diff FILE1 FILE2" ; exit 0 ;;
  --version|-v) echo "neos-diff ${NEOS_VERSION}" ; exit 0 ;;
esac
if [[ $# -lt 2 ]]; then
  echo "usage: neos-diff FILE1 FILE2" >&2
  exit 2
fi
if command -v diff >/dev/null 2>&1; then
  diff --color=auto "$1" "$2" || true
else
  echo "neos-diff: diff not available" >&2
  exit 1
fi
