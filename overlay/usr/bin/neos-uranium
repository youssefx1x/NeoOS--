#!/usr/bin/env bash
# neos-uranium — NeoOS driver installer + database connector.
# Subcommands:
#   install (default): enable non-free-firmware, refresh DB, install every driver pkg.
#   suggest           : detect hardware and suggest drivers (DB + apt package index).
#   update            : refresh online package/driver databases (apt-get update).
#   list              : print the driver package manifest.
#   scan              : raw hardware detection (lspci/lsusb).
set -euo pipefail

log()  { [[ $QUIET -eq 0 ]] && printf '\033[1;35m[uranium]\033[0m %s\n' "$*" || true; }
warn() { printf '\033[1;33m[uranium]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[uranium]\033[0m %s\n' "$*" >&2; }

QUIET=0
PARSED=()
for a in "$@"; do
  case "$a" in
    --quiet|-q) QUIET=1 ;;
    *) PARSED+=("$a") ;;
  esac
done
set -- "${PARSED[@]+"${PARSED[@]}"}"

CMD="${1:-install}"

MANIFEST="${NEOS_DRIVERS_MANIFEST:-/usr/lib/neos/packages.drivers}"
if [[ -z "$MANIFEST" || ! -f "$MANIFEST" ]]; then
  MANIFEST="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd)/config/packages.drivers"
  [[ -f "$MANIFEST" ]] || MANIFEST=""
fi

DB="${NEOS_DRIVER_DB:-/usr/lib/neos/driver-db.tsv}"
if [[ ! -f "$DB" ]]; then
  DB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd)/config/driver-db.tsv"
  [[ -f "$DB" ]] || DB=""
fi

FALLBACK_LIST=(
  firmware-linux firmware-linux-nonfree firmware-misc-nonfree
  firmware-amd-graphics firmware-realtek firmware-atheros
  firmware-iwlwifi firmware-brcm80211
  mesa-utils libgl1-mesa-dri mesa-vulkan-drivers vulkan-tools
  libva-mesa-driver mesa-va-drivers intel-media-va-driver
  wireless-tools iw rfkill wpasupplicant network-manager
  bluez bluez-tools alsa-utils pipewire pipewire-pulse
  cups printer-driver-gutenprint hwdata pciutils usbutils lshw
  qemu-guest-agent
)

list_pkgs() {
  if [[ -n "$MANIFEST" && -f "$MANIFEST" ]]; then
    grep -vE '^[[:space:]]*(#|$)' "$MANIFEST"
  else
    printf '%s\n' "${FALLBACK_LIST[@]}"
  fi
}

need_root() {
  if [[ $EUID -ne 0 ]]; then
    if command -v sudo >/dev/null 2>&1; then exec sudo "$0" "$@"; fi
    err "needs root privileges. re-run with sudo."
    exit 1
  fi
}

enable_sources() {
  local sl=/etc/apt/sources.list
  touch "$sl" 2>/dev/null || true
  if ! grep -q 'non-free-firmware' "$sl" 2>/dev/null; then
    log "enabling non-free-firmware component"
    cp "$sl" "$sl.bak" 2>/dev/null || true
    sed -i 's/ main / main contrib non-free-firmware /; s/main$/main contrib non-free-firmware/' "$sl"
  fi
}

install_all() {
  local action="${1:-install}"
  need_root "$action"
  enable_sources
  log "updating package index..."
  apt-get update
  local ok=0 fail=0 pkg
  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    log "installing $pkg"
    if apt-get install -y "$pkg" >/dev/null 2>&1; then
      ok=$((ok + 1))
    else
      warn "$pkg unavailable or failed — skipping"
      fail=$((fail + 1))
    fi
  done < <(list_pkgs)
  log "done: $ok installed, $fail skipped"
}

scan() {
  log "Detected hardware:"
  printf '  -- CPU --\n'
  grep -m1 "model name" /proc/cpuinfo | sed 's/^model name[[:space:]]*:[[:space:]]*/     /' || true
  printf '  -- PCI --\n'
  (lspci -nn 2>/dev/null | head -20 || printf '     (lspci not available)\n') | sed 's/^/     /'
  printf '  -- USB --\n'
  (lsusb 2>/dev/null | head -12 || printf '     (lsusb not available)\n') | sed 's/^/     /'
}

suggest() {
  command -v lspci >/dev/null 2>&1 || { warn "lspci not installed (install pciutils)"; }
  local pci usb id pkg note seen=0
  pci="$(lspci -nn 2>/dev/null || true)"
  usb="$(lsusb 2>/dev/null || true)"

  log "Driver suggestions (database + apt package index)"
  printf '\n%-18s %-28s %s\n' "DEVICE" "SUGGESTED PKG" "NOTE"

  if [[ -n "$DB" && -f "$DB" ]]; then
    while IFS=$'\t' read -r id pkg note; do
      [[ -z "${id:-}" || "$id" == \#* ]] && continue
      if [[ "$pci" == *"$id"* ]]; then
        printf '%-18s %-28s %s\n' "$id" "$pkg" "$note"
        seen=1
      fi
    done < "$DB"
  fi

  # Vendor-name based firmware suggestions (broadcom/atheros/intel/realtek/amd/nvidia)
  add_vendor() {
    printf '%-18s %-28s %s\n' "$1" "$2" "$3"
    seen=1
  }
  {
    [[ "$pci" == *"Broadcom"* || "$pci" == *"brcm"* || "$usb" == *"Broadcom"* ]] && add_vendor "broadcom-wifi" "firmware-brcm80211" "wifi firmware"
    [[ "$pci" == *"Atheros"* || "$pci" == *"atheros"* ]]                    && add_vendor "atheros-wifi" "firmware-atheros" "wifi firmware"
    [[ "$pci" == *"Intel"* && "$pci" == *"Network"* ]]                      && add_vendor "intel-wifi" "firmware-iwlwifi" "wifi firmware"
    [[ "$pci" == *"Realtek"* ]]                                             && add_vendor "realtek" "firmware-realtek" "wifi/eth firmware"
    [[ "$pci" == *"AMD"* || "$pci" == *"ATI"* || "$pci" == *"Radeon"* ]]     && add_vendor "amd-gpu" "firmware-amd-graphics" "amd gpu firmware"
    [[ "$pci" == *"NVIDIA"* ]]                                              && add_vendor "nvidia-gpu" "nvidia-driver" "nvidia proprietary gpu"
  } 2>/dev/null || true

  if [[ $seen -eq 0 ]]; then
    log "no additional drivers detected — base firmware covers this hardware"
  fi
  echo
  log "run 'neos-uranium install' to install these packages (requires network + root)"
}

case "$CMD" in
  install|all) install_all "$CMD" ;;
  suggest|scan)   if [[ "$CMD" == "scan" ]]; then scan; else suggest; fi ;;
  update)
    apt-get update
    log "online driver databases refreshed"
    ;;
  list) list_pkgs ;;
  -h|--help|"")
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    err "unknown subcommand: $CMD"
    exit 2
    ;;
esac
