#!/usr/bin/env bash
# neos-ipc — NeoIPC: inter-component communication endpoints
set -euo pipefail
echo "NeoIPC endpoints:"
found=0
for s in /run/neos/neo.sock /run/neos/neo.ipc; do
  if [[ -S "$s" ]]; then echo "  socket: $s"; found=1; fi
done
[[ $found -eq 0 ]] && echo "  (no IPC socket active)"
command -v socat >/dev/null 2>&1 && echo "  bridge: socat available" || echo "  bridge: install socat"
case "${1:-}" in
  send) echo "neos-ipc send: publish a message to the NeoEvent bus" ;;
  recv) echo "neos-ipc recv: subscribe to NeoEvent events" ;;
  *) echo "usage: neos-ipc [send|recv] [msg]" >&2 ;;
esac
