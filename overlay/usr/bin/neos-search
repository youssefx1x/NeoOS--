#!/usr/bin/env bash
# neos-search — NeoSearch: system-wide content search (rg/grep wrapper)
set -euo pipefail
if [[ $# -eq 0 ]]; then echo "usage: neos-search <pattern> [path]" >&2; exit 2; fi
pat="$1"; path="${2:-.}"
if command -v rg >/dev/null 2>&1; then
  exec rg --color=always "$pat" "$path" 2>/dev/null
elif command -v grep >/dev/null 2>&1; then
  exec grep --color=auto -r "$pat" "$path"
else
  echo "neos-search: rg/grep not available" >&2
  exit 1
fi
